; lin standard library: hardware accelerator driver interface
(load "ffi.lin")

; set the sole active wavefront reduction driver: "cpu", "simd", or a dynamic plugin symbol
(define set_driver (\name (ccall "driver_set" (cons name nil))))

; add a driver to the pipeline (most-recently-added has priority); "cpu" clears to base
(define add_driver (\name (ccall "driver_add" (cons name nil))))

; reset the pipeline to the base cpu engine
(define clear_drivers (ccall "driver_clear" nil))

; get the active (last-added) driver name
(define get_driver (ccall "driver_get" nil))
