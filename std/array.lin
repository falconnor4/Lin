; ==============================================================================
; Lin Standard Library: Array -- indexed storage with in-place update
; ==============================================================================
; An array of n elements is a 32-way radix trie: `get` and `set` walk one node per
; five bits of the index (4 levels for a million elements).  It is ordinary
; Lin -- a datatype and `match` -- so it is persistent by default: `aset` returns a
; new array and the old one is unchanged.  And because it is a datatype, the
; function compiler reads it as C blocks and proves ownership from the net: an
; array nothing else holds is updated IN PLACE, path node by path node, which is
; what a mutable vector costs.  No mutation, no borrow checker, no GC.
;
;   (array n x)        n copies of x
;   (alen a)           its length
;   (aget a i)         element i
;   (aset a i x)       a with element i replaced
;   (apush a x)        a with x appended (grows a level when full)
;   (afold f z a)      f over the elements in order, from z
;   (aof_seq s)        the elements of a Seq, as an array
;   (ato_seq a)        the array's elements, as a Seq
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "seq.lin")

(namespace array)

; a trie node: 32 children; a leaf: one element; the empty slot of a trie not yet filled
(datatype (Trie a) (tempty) (tleaf (v a))
  (tnode (c0 Trie a) (c1 Trie a) (c2 Trie a) (c3 Trie a) (c4 Trie a) (c5 Trie a) (c6 Trie a) (c7 Trie a) (c8 Trie a) (c9 Trie a) (c10 Trie a) (c11 Trie a) (c12 Trie a) (c13 Trie a) (c14 Trie a) (c15 Trie a) (c16 Trie a) (c17 Trie a) (c18 Trie a) (c19 Trie a) (c20 Trie a) (c21 Trie a) (c22 Trie a) (c23 Trie a) (c24 Trie a) (c25 Trie a) (c26 Trie a) (c27 Trie a) (c28 Trie a) (c29 Trie a) (c30 Trie a) (c31 Trie a)))
; an array: its length, the trie's depth in levels of 3 bits, the trie
(datatype (Arr a) (arr (len num) (depth num) (root Trie a)))

(define _digit (\i (\d (band (shr i (mul 5 d)) 31))))
(define _pick (\k (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8 (\c9 (\c10 (\c11 (\c12 (\c13 (\c14 (\c15 (\c16 (\c17 (\c18 (\c19 (\c20 (\c21 (\c22 (\c23 (\c24 (\c25 (\c26 (\c27 (\c28 (\c29 (\c30 (\c31 
  (if (lt k 16) (if (lt k 8) (if (lt k 4) (if (lt k 2) (if (eq k 0) c0 c1) (if (eq k 2) c2 c3)) (if (lt k 6) (if (eq k 4) c4 c5) (if (eq k 6) c6 c7))) (if (lt k 12) (if (lt k 10) (if (eq k 8) c8 c9) (if (eq k 10) c10 c11)) (if (lt k 14) (if (eq k 12) c12 c13) (if (eq k 14) c14 c15)))) (if (lt k 24) (if (lt k 20) (if (lt k 18) (if (eq k 16) c16 c17) (if (eq k 18) c18 c19)) (if (lt k 22) (if (eq k 20) c20 c21) (if (eq k 22) c22 c23))) (if (lt k 28) (if (lt k 26) (if (eq k 24) c24 c25) (if (eq k 26) c26 c27)) (if (lt k 30) (if (eq k 28) c28 c29) (if (eq k 30) c30 c31)))))))))))))))))))))))))))))))))))))))

(define _tget (\t (\i (\d (match t
  (tempty 0)
  ((tleaf v) v)
  ((tnode c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31)
    (_tget (_pick (_digit i d) c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31) i (sub d 1))))))))

;  A trie of depth d holding x in its slots lo .. n-1 (the rest left empty, so `array` costs n, not the
;  capacity).  32 DISTINCT subtrees -- their offsets make them distinct: a node that stored one subtree 32 times
;  could never be updated in place.
(define _tfill (\d (\x (\lo (\n (if (geq lo n) tempty (if (lt d 0) (tleaf x)
  (let ((e (sub d 1)) (w (shl 1 (mul 5 d))))
    (tnode (_tfill e x (add lo (mul 0 w)) n) (_tfill e x (add lo (mul 1 w)) n) (_tfill e x (add lo (mul 2 w)) n) (_tfill e x (add lo (mul 3 w)) n) (_tfill e x (add lo (mul 4 w)) n) (_tfill e x (add lo (mul 5 w)) n) (_tfill e x (add lo (mul 6 w)) n) (_tfill e x (add lo (mul 7 w)) n) (_tfill e x (add lo (mul 8 w)) n) (_tfill e x (add lo (mul 9 w)) n) (_tfill e x (add lo (mul 10 w)) n) (_tfill e x (add lo (mul 11 w)) n) (_tfill e x (add lo (mul 12 w)) n) (_tfill e x (add lo (mul 13 w)) n) (_tfill e x (add lo (mul 14 w)) n) (_tfill e x (add lo (mul 15 w)) n) (_tfill e x (add lo (mul 16 w)) n) (_tfill e x (add lo (mul 17 w)) n) (_tfill e x (add lo (mul 18 w)) n) (_tfill e x (add lo (mul 19 w)) n) (_tfill e x (add lo (mul 20 w)) n) (_tfill e x (add lo (mul 21 w)) n) (_tfill e x (add lo (mul 22 w)) n) (_tfill e x (add lo (mul 23 w)) n) (_tfill e x (add lo (mul 24 w)) n) (_tfill e x (add lo (mul 25 w)) n) (_tfill e x (add lo (mul 26 w)) n) (_tfill e x (add lo (mul 27 w)) n) (_tfill e x (add lo (mul 28 w)) n) (_tfill e x (add lo (mul 29 w)) n) (_tfill e x (add lo (mul 30 w)) n) (_tfill e x (add lo (mul 31 w)) n))))))))))

(define _tset (\t (\i (\d (\x (match t
  (tempty (if (lt d 0) (tleaf x) (_tset (tnode tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty) i d x)))
  ((tleaf v) (tleaf x))
  ((tnode c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31)
    (let ((k (_digit i d)))
      (tnode (if (eq k 0) (_tset c0 i (sub d 1) x) c0) (if (eq k 1) (_tset c1 i (sub d 1) x) c1) (if (eq k 2) (_tset c2 i (sub d 1) x) c2) (if (eq k 3) (_tset c3 i (sub d 1) x) c3) (if (eq k 4) (_tset c4 i (sub d 1) x) c4) (if (eq k 5) (_tset c5 i (sub d 1) x) c5) (if (eq k 6) (_tset c6 i (sub d 1) x) c6) (if (eq k 7) (_tset c7 i (sub d 1) x) c7) (if (eq k 8) (_tset c8 i (sub d 1) x) c8) (if (eq k 9) (_tset c9 i (sub d 1) x) c9) (if (eq k 10) (_tset c10 i (sub d 1) x) c10) (if (eq k 11) (_tset c11 i (sub d 1) x) c11) (if (eq k 12) (_tset c12 i (sub d 1) x) c12) (if (eq k 13) (_tset c13 i (sub d 1) x) c13) (if (eq k 14) (_tset c14 i (sub d 1) x) c14) (if (eq k 15) (_tset c15 i (sub d 1) x) c15) (if (eq k 16) (_tset c16 i (sub d 1) x) c16) (if (eq k 17) (_tset c17 i (sub d 1) x) c17) (if (eq k 18) (_tset c18 i (sub d 1) x) c18) (if (eq k 19) (_tset c19 i (sub d 1) x) c19) (if (eq k 20) (_tset c20 i (sub d 1) x) c20) (if (eq k 21) (_tset c21 i (sub d 1) x) c21) (if (eq k 22) (_tset c22 i (sub d 1) x) c22) (if (eq k 23) (_tset c23 i (sub d 1) x) c23) (if (eq k 24) (_tset c24 i (sub d 1) x) c24) (if (eq k 25) (_tset c25 i (sub d 1) x) c25) (if (eq k 26) (_tset c26 i (sub d 1) x) c26) (if (eq k 27) (_tset c27 i (sub d 1) x) c27) (if (eq k 28) (_tset c28 i (sub d 1) x) c28) (if (eq k 29) (_tset c29 i (sub d 1) x) c29) (if (eq k 30) (_tset c30 i (sub d 1) x) c30) (if (eq k 31) (_tset c31 i (sub d 1) x) c31))))))))))

; how many levels n elements need
(define _depth_for (\n (\d (if (leq n (shl 32 (mul 5 d))) d (_depth_for n (add d 1))))))

(define array (\n (\x (let ((d (_depth_for n 0))) (arr n d (_tfill d x 0 n))))))
(define alen (\a (match a ((arr n d t) n))))
(define aget (\a (\i (match a ((arr n d t) (_tget t i d))))))
(define aset (\a (\i (\x (match a ((arr n d t) (arr n d (_tset t i d x))))))))
(define apush (\a (\x (match a ((arr n d t)
  (if (lt n (shl 32 (mul 5 d)))
    (arr (add n 1) d (_tset t n d x))
    (arr (add n 1) (add d 1)
      (_tset (tnode t tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty tempty) n (add d 1) x))))))))
; in index order, the first (alen a) elements only (a trie is filled to its capacity)
(define _afold (\f (\z (\a (\i (\n (if (lt i n) (_afold f (f z (aget a i)) a (add i 1) n) z)))))))
(define afold (\f (\z (\a (_afold f z a 0 (alen a))))))
(define aempty (arr 0 0 tempty))
(define _aof (\s (\a (match s (snil a) ((scons h t) (_aof t (apush a h)))))))
(define aof_seq (\s (_aof s aempty)))
(define ato_seq (\a (sreverse (afold (\acc (\x (scons x acc))) snil a))))

(namespace _)
(export array)
