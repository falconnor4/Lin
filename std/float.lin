; ==============================================================================
; Lin Standard Library: Floating-Point Arithmetic & Trigonometry
; ==============================================================================
; A float is a Scott numeral carrying the IEEE-754 bit pattern of a double,
; keyed under the _fsz/_fss spine (so it never collides with integer numerals).
; All operations reduce through FFI closures (lin_fadd, lin_fsin, ...) to the
; C math library; the SIMD driver may later fold these natively during
; reduction.  Readback renders a float as %g.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "ffi.lin")

(namespace float)

; --- Construction ---
; Parse a decimal string into a float, e.g. (float "2.5").
(define! float (a -> float) (\s (ccall "lin_parse_float" (cons s nil))))
; Promote an integer to a float.
(define! i2f (num -> float) (\i (ccall "lin_float" (cons i nil))))

; --- Arithmetic (binary) ---
(define! fadd (float -> float -> float) (\a (\b (ccall "lin_fadd" (cons a (cons b nil))))))
(define! fsub (float -> float -> float) (\a (\b (ccall "lin_fsub" (cons a (cons b nil))))))
(define! fmul (float -> float -> float) (\a (\b (ccall "lin_fmul" (cons a (cons b nil))))))
(define! fdiv (float -> float -> float) (\a (\b (ccall "lin_fdiv" (cons a (cons b nil))))))
(define! fpow (float -> float -> float) (\a (\b (ccall "lin_fpow" (cons a (cons b nil))))))
(define! fatan2 (float -> float -> float) (\a (\b (ccall "lin_fatan2" (cons a (cons b nil))))))

; --- Unary ---
(define! fsqrt (float -> float) (\x (ccall "lin_fsqrt" (cons x nil))))
(define! fsin  (float -> float) (\x (ccall "lin_fsin" (cons x nil))))
(define! fcos  (float -> float) (\x (ccall "lin_fcos" (cons x nil))))
(define! ftan  (float -> float) (\x (ccall "lin_ftan" (cons x nil))))

; --- Comparison (bool) ---
(define! feq  (float -> float -> bool) (\a (\b (ccall "lin_feq" (cons a (cons b nil))))))
(define! flt  (float -> float -> bool) (\a (\b (ccall "lin_flt" (cons a (cons b nil))))))
(define! fleq (float -> float -> bool) (\a (\b (ccall "lin_fleq" (cons a (cons b nil))))))
(define! fgt (float -> float -> bool) (\a (\b (not (fleq a b)))))
(define! fgeq (float -> float -> bool) (\a (\b (not (flt a b)))))

; --- Coercion / constants ---
; Truncate toward zero (floor) to an integer-valued float.
(define! ffloor (float -> float) (\x (ccall "lin_ffloor" (cons x nil))))
(define pi (float "3.14159265358979323846"))
(define e  (float "2.71828182845904523536"))

(namespace _)
(export float)