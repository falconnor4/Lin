; ==============================================================================
; Lin Standard Library: Floating-Point Arithmetic & Trigonometry
; ==============================================================================
; A float is a Scott numeral carrying the IEEE-754 bit pattern of a double,
; keyed under the _fsz/_fss spine (so it never collides with integer numerals).
; All operations reduce through FFI closures (lin_fadd, lin_fsin, ...) to the
; C math library; the SIMD driver may later fold these natively during
; reduction.  Readback renders a float as %g.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "ffi.lin")

(namespace float)

; --- Construction ---
; Parse a decimal string into a float, e.g. (float "2.5").
(define! float (a -> float) (\s (ccall1 "lin_parse_float" s)))
; Promote an integer to a float.
(define! i2f (num -> float) (\i (ccall1 "lin_float" i)))

; --- Arithmetic (binary) ---
(define! fadd (float -> float -> float) (\a (\b (ccall2 "lin_fadd" a b))))
(define! fsub (float -> float -> float) (\a (\b (ccall2 "lin_fsub" a b))))
(define! fmul (float -> float -> float) (\a (\b (ccall2 "lin_fmul" a b))))
(define! fdiv (float -> float -> float) (\a (\b (ccall2 "lin_fdiv" a b))))
(define! fpow (float -> float -> float) (\a (\b (ccall2 "lin_fpow" a b))))
(define! fatan2 (float -> float -> float) (\a (\b (ccall2 "lin_fatan2" a b))))

; --- Unary ---
(define! fsqrt (float -> float) (\x (ccall1 "lin_fsqrt" x)))
(define! fsin  (float -> float) (\x (ccall1 "lin_fsin" x)))
(define! fcos  (float -> float) (\x (ccall1 "lin_fcos" x)))
(define! ftan  (float -> float) (\x (ccall1 "lin_ftan" x)))

; --- Comparison (bool) ---
(define! feq  (float -> float -> bool) (\a (\b (ccall2 "lin_feq" a b))))
(define! flt  (float -> float -> bool) (\a (\b (ccall2 "lin_flt" a b))))
(define! fleq (float -> float -> bool) (\a (\b (ccall2 "lin_fleq" a b))))
(define! fgt (float -> float -> bool) (\a (\b (not (fleq a b)))))
(define! fgeq (float -> float -> bool) (\a (\b (not (flt a b)))))

; --- Coercion / constants ---
; Truncate toward zero (floor) to an integer-valued float.
(define! ffloor (float -> float) (\x (ccall1 "lin_ffloor" x)))
(define pi (float "3.14159265358979323846"))
(define e  (float "2.71828182845904523536"))

(namespace _)
(export float)