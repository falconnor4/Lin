; ==============================================================================
; Lin Standard Library: Lazy Streams & Infinite Sequences
; ==============================================================================
; Lazy generator sequences, positional projections, and Church-iterated
; nth/drop combinators.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "pair.lin")
(load "list.lin")

(namespace stream)
(define create (\s0 (\next (pair s0 next))))
(define head (\s (fst s)))
(define! tail (a -> b) (\s (s (\curr (\step (pair (step curr) step))))))

(define nats (\n (create n succ)))
(define repeat (\x (create x (\v v))))

(define drop1 stream.tail)
(define drop2 (\s (stream.tail (stream.tail s))))
(define drop3 (\s (stream.tail (stream.tail (stream.tail s)))))

(define nth0 stream.head)
(define nth1 (\s (stream.head (stream.drop1 s))))
(define nth2 (\s (stream.head (stream.drop2 s))))
(define nth3 (\s (stream.head (stream.drop3 s))))

(define take1 (\s (list1 (stream.head s))))
(define take2 (\s (list2 (stream.head s) (stream.head (stream.tail s)))))
(define take3 (\s (list3 (stream.head s) (stream.head (stream.tail s)) (stream.head (stream.tail (stream.tail s))))))
(define take4 (\s (list4 (stream.head s) (stream.head (stream.tail s)) (stream.head (stream.tail (stream.tail s))) (stream.head (stream.tail (stream.tail (stream.tail s)))))))

; General Church self-iterating nth & drop
(define! nth_c (a -> b -> c) (\cn (\s (stream.head (cn stream.tail s)))))
(define! drop_c (a -> b -> c) (\cn (\s (cn stream.tail s))))

(namespace _)
(open stream)
(define stream_create stream.create)
(define stream_head stream.head)
(define stream_tail stream.tail)
(define nats_from stream.nats)
(define repeat stream.repeat)
(define stream_drop1 stream.drop1)
(define stream_drop2 stream.drop2)
(define stream_drop3 stream.drop3)
(define stream_nth0 stream.nth0)
(define stream_nth1 stream.nth1)
(define stream_nth2 stream.nth2)
(define stream_nth3 stream.nth3)
(define stream_take1 stream.take1)
(define stream_take2 stream.take2)
(define stream_take3 stream.take3)
(define stream_take4 stream.take4)
(define stream_nth_c stream.nth_c)
(define stream_drop_c stream.drop_c)
