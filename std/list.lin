; ==============================================================================
; Lin Standard Library: Lists & Linear Sequences
; ==============================================================================
; Combines Scott-encoded lists (for O(1) head, tail, and pattern matching)
; with Church-encoded lists (for pure unbounded self-iterating folds).
; ==============================================================================

(load "bool.lin")
(load "num.lin")

(namespace list)
(define! nil (list a) (\c (\n bool.true)))
(define! cons (a -> list a -> list a) (\h (\t (\c (\n ((c h) t))))))
(define! head (list a -> a) (\l ((l (\h (\t h))) list.nil)))
(define! tail (list a -> list a) (\l ((l (\h (\t t))) list.nil)))
(define! is_empty (list a -> bool) (\l ((l (\h (\t bool.false))) bool.true)))

; Church self-iterating lists & folds
(define c_nil (\c (\n n)))
(define c_cons (\h (\t (\c (\n (c h (t c n)))))))
(define c_foldr (\f (\z (\l (l f z)))))
(define c_foldl (\f (\z (\l ((l (\x (\g (\acc (g (f acc x))))) (\acc acc)) z)))))
(define c_length (\l (l (\_ (\acc (num.succ acc))) 0)))
(define c_map (\f (\l (\c (\n (l (\x (c (f x))) n))))))
(define c_filter (\p (\l (\c (\n (l (\x (bool.if (p x) (c x) (\acc acc))) n))))))
(define c_concat (\l1 (\l2 (\c (\n (l1 c (l2 c n)))))))
(define c_to_scott (\cl (cl list.cons list.nil)))
(define c_reverse (\cl (list.c_foldl (\acc (\x (list.c_cons x acc))) list.c_nil cl)))

; Positional constructors
(define list1 (\a (list.cons a list.nil)))
(define list2 (\a (\b (list.cons a (list.cons b list.nil)))))
(define list3 (\a (\b (\c (list.cons a (list.cons b (list.cons c list.nil)))))))
(define list4 (\a (\b (\c (\d (list.cons a (list.cons b (list.cons c (list.cons d list.nil)))))))))
(define list5 (\a (\b (\c (\d (\e (list.cons a (list.cons b (list.cons c (list.cons d (list.cons e list.nil)))))))))))

; Direct O(1) positional projections
(define first list.head)
(define second (\l (list.head (list.tail l))))
(define third  (\l (list.head (list.tail (list.tail l)))))
(define fourth (\l (list.head (list.tail (list.tail (list.tail l))))))
(define fifth  (\l (list.head (list.tail (list.tail (list.tail (list.tail l)))))))
(define sixth  (\l (list.head (list.tail (list.tail (list.tail (list.tail (list.tail l))))))))
(define seventh (\l (list.head (list.tail (list.tail (list.tail (list.tail (list.tail (list.tail l)))))))))
(define eighth  (\l (list.head (list.tail (list.tail (list.tail (list.tail (list.tail (list.tail (list.tail l))))))))))

; Aliases
(define nth1 list.first)
(define nth2 list.second)
(define nth3 list.third)
(define nth4 list.fourth)
(define nth5 list.fifth)

(namespace _)
(open list)
(define nil list.nil)
(define cons list.cons)
(define head list.head)
(define tail list.tail)
(define is_empty list.is_empty)
(define list1 list.list1)
(define list2 list.list2)
(define list3 list.list3)
(define list4 list.list4)
(define list5 list.list5)
(define first list.first)
(define second list.second)
(define third list.third)
(define fourth list.fourth)
(define fifth list.fifth)
(define sixth list.sixth)
(define seventh list.seventh)
(define eighth list.eighth)
(define nth1 list.nth1)
(define nth2 list.nth2)
(define nth3 list.nth3)
(define nth4 list.nth4)
(define nth5 list.nth5)
(define c_nil list.c_nil)
(define c_cons list.c_cons)
(define c_foldr list.c_foldr)
(define c_foldl list.c_foldl)
(define c_length list.c_length)
(define c_map list.c_map)
(define c_filter list.c_filter)
(define c_concat list.c_concat)
(define c_to_scott list.c_to_scott)
(define c_reverse list.c_reverse)
