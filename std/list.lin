; lin standard library: lists
(load "bool.lin")
(load "num.lin")

(define! nil (list a) (\c (\n true)))
(define! cons (a -> list a -> list a) (\h (\t (\c (\n ((c h) t))))))
(define! head (list a -> a) (\l ((l (\h (\t h))) nil)))
(define! tail (list a -> list a) (\l ((l (\h (\t t))) nil)))
(define! is_empty (list a -> bool) (\l ((l (\h (\t false))) true)))
(define! length (list a -> num) (\l (ifl (is_empty l) (\_ 0) (\_ (succ (length (tail l)))))))
