; ==============================================================================
; Lin Standard Library: Lists & Linear Sequences
; ==============================================================================
; Scott-encoded lists (O(1) head/tail/pattern-matching) plus Church-encoded
; self-iterating lists & folds.  The positional projections (first..eighth) are
; thin wrappers over the single generic recursive `nth`, so the projection
; family shares one encoding instead of hand-unrolled head/tail chains.
; ==============================================================================

(load "bool.lin")
(load "num.lin")

(namespace list)

; --- Scott list core ---
(define! nil (list a) (\c (\n bool.true)))
(define! cons (a -> list a -> list a) (\h (\t (\c (\n ((c h) t))))))
(define! head (list a -> a) (\l ((l (\h (\t h))) list.nil)))
(define! tail (list a -> list a) (\l ((l (\h (\t t))) list.nil)))
(define! is_empty (list a -> bool) (\l ((l (\h (\t bool.false))) bool.true)))

; --- Higher-order list equality (public list_eq over internal _eq) ---
(define _eq
  (\elem_eq
    (\l1 (\l2
      (bool.ifl (is_empty l1)
        (\_ (is_empty l2))
        (\_ (bool.ifl (is_empty l2)
              (\_ bool.false)
              (\_ (bool.and ((elem_eq (head l1)) (head l2))
                            (((_eq elem_eq) (tail l1)) (tail l2)))))))))))
(define list_eq _eq)

; --- Generic positional projection (terminating recursion) ---
; O(i): hoist head repeatedly; the index drives the recursion to 0, bounding the
; depth by the requested position and keeping nth generic over the element type
; (an `is_empty` guard that yields `nil` would pin nth to lists-of-lists under HM
; inference, so termination is index-driven; valid positions never hit the end).
(define nth
  (\i (\l
    (bool.ifl (is_zero i)
      (\_ (head l))
      (\_ (nth (pred i) (tail l)))))))

; --- Positional projections (thin nth wrappers) ---
(define first  (\l (nth 0 l)))
(define second (\l (nth 1 l)))
(define third  (\l (nth 2 l)))
(define fourth (\l (nth 3 l)))
(define fifth  (\l (nth 4 l)))
(define sixth  (\l (nth 5 l)))
(define seventh (\l (nth 6 l)))
(define eighth  (\l (nth 7 l)))

; --- 1-based projection aliases ---
(define nth1 list.first)
(define nth2 list.second)
(define nth3 list.third)
(define nth4 list.fourth)
(define nth5 list.fifth)

; --- Positional constructors ---
(define list1 (\a (cons a nil)))
(define list2 (\a (\b (cons a (cons b nil)))))
(define list3 (\a (\b (\c (cons a (cons b (cons c nil)))))))
(define list4 (\a (\b (\c (\d (cons a (cons b (cons c (cons d nil)))))))))
(define list5 (\a (\b (\c (\d (\e (cons a (cons b (cons c (cons d (cons e nil)))))))))))

; --- Church self-iterating lists & folds ---
(define c_nil (\c (\n n)))
(define c_cons (\h (\t (\c (\n (c h (t c n)))))))
(define c_foldr (\f (\z (\l (l f z)))))
(define c_foldl (\f (\z (\l ((l (\x (\g (\acc (g (f acc x))))) (\acc acc)) z)))))
(define c_length (\l (l (\_ (\acc (num.succ acc))) 0)))
(define c_map (\f (\l (\c (\n (l (\x (c (f x))) n))))))
(define c_filter (\p (\l (\c (\n (l (\x (bool.if (p x) (c x) (\acc acc))) n))))))
(define c_concat (\l1 (\l2 (\c (\n (l1 c (l2 c n)))))))
(define c_to_scott (\cl (cl list.cons list.nil)))
(define c_reverse (\cl (list.c_foldl (\acc (\x (list.c_cons x acc))) list.c_nil cl)))

; --- Re-export public members into root scope ---
(namespace _)
(export list)