; ==============================================================================
; Lin Standard Library: Input / Output Primitives & Foreign Calls
; ==============================================================================
; Asynchronous event-driven I/O, destination-directed stream writing, and
; POSIX file operations integrated with interaction net readback.
;
; AN EFFECT IS A VALUE OF THE DATATYPE `_Io` below: one constructor per effect, in the order
; std/drivers/readback.c enumerates them -- 0 done, 1 print (msg, next), 2 write_to (dst, msg,
; next), 3 wait (src, cb), 4 loop (state, step), 5 next (state).  A constructor's marker says
; which effect a value is (the same marker every datatype's values carry), so an effect is never
; mistaken for other data whatever its payloads, and the compiler builds and returns effects as
; it does any datatype -- which is what lets a loop's step run compiled.  Field names start with
; `_eff`: that is how the compiler tells a form that performs effects (main.c, term_impure).
;
;
; THE TYPE `io` (a builtin nominal, src/io.c) is what every effect is.  Structurally an effect's continuation
; is an effect again, so without a name the type of any loop through effects is infinite and the checker
; refuses it; named, `(define loop (\s (io_print s (loop (add s 1)))))` is `num -> io`.  The encodings are
; defined untyped under `_` names and the public ones state the type, so the checker sees `io` and the
; reducer sees exactly the encoding it always did.
;
; Every public member below carries the globally-safe `io_*` name (never bare
; `wait`/`read`/`file`/`write_to`/`print`/`done`/`prompt`/`call`), so
; `(export io)` re-exports exactly those safe names bare without colliding with
; the bare short names other std modules export.  The low-level POSIX C
; bindings keep their stable bare names (`puts`/`putchar`/`fopen`/`fclose`/
; `fgetc`/`fputc`), matching the consumer-facing API.  The qualified short-name
; references consumers still use (`io.wait`/`io.read`/`io.file`/`io.print`/...)
; are bound at root as plain aliases AFTER `(export io)`, so they are reachable
; qualified but never leaked bare.
; ==============================================================================

(load "list.lin")
(load "ffi.lin")

(namespace io)

(datatype _Io (eff_done _eff_u) (eff_print _eff_msg _eff_next) (eff_write _eff_dst _eff_wmsg _eff_wnext)
              (eff_wait _eff_src _eff_cb) (eff_loop _eff_s _eff_step) (eff_next _eff_st))

; --- Asynchronous Waiting & Reading ---
; Waits for events from descriptors, commands, files, timers, or FFI results:
;   - 0 or "stdin": terminal input
;   - fd (integer): file descriptor / pipe / socket
;   - "!cmd" or "cmd:...": process output
;   - "file:...": disk file contents
;   - "sleep:ms": timer delay
(define _wait (\src (\cb (io.eff_wait src cb))))
(define! io_wait (a -> (b -> c) -> io) io._wait)
(define io_read (\cb (io.io_wait 0 cb)))
; all of standard input, as one string
(define io_read_all (\cb (io.io_wait "stdin:all" cb)))
(define io_file (\path (\cb (io.io_wait path cb))))

; --- Destination-Directed Output ---
;   - 1 or omitted: standard output
;   - 2: standard error
(define _write_to (\dst (\msg (\next (io.eff_write dst msg next)))))
(define! io_write_to (num -> a -> b -> io) io._write_to)
(define _print (\msg (\next (io.eff_print msg next))))
(define! io_print (a -> b -> io) io._print)
(define _done (io.eff_done 0))
(define! io_done io io._done)

; --- Loops ---
; (io_loop s step): run (step s); a turn that ends in (io_next s2) runs (step s2), and one that ends in
; io_done ends the program.  Write a long-running loop -- a game's frames, a server's requests -- this way
; rather than as a recursive function: the runner hands each turn a fresh copy of `step`, so what a turn
; computes reads as plain values when it reaches a call to the world (std/drivers/readback.c, EFF_LOOP).
(define _loop (\s (\step (io.eff_loop s step))))
(define! io_loop (a -> (a -> io) -> io) io._loop)
(define _next (\s (io.eff_next s)))
(define! io_next (a -> io) io._next)

; --- Interactive Utilities ---
(define io_prompt   (\p (\cb (io.io_print p (io.io_read cb)))))

; --- Native C Standard I/O Bindings ---
(define puts     (\s (ffi.ccall "puts" (cons s nil))))
(define putchar  (\c (ffi.ccall "putchar" (cons c nil))))
(define fopen    (\path (\mode (ffi.ccall "fopen" (cons path (cons mode nil))))))
(define fclose   (\fp (ffi.ccall "fclose" (cons fp nil))))
(define fgetc    (\fp (ffi.ccall "fgetc" (cons fp nil))))
(define fputc    (\c (\fp (ffi.ccall "fputc" (cons c (cons fp nil))))))

; --- Monadic Wrappers ---
(define io_call       (\fn (\args (\cb (io.io_wait (ffi.ffi fn args) cb)))))
(define io_puts       (\s (\next (io.io_wait (io.puts s) (\_ next)))))
(define io_putchar    (\c (\next (io.io_wait (io.putchar c) (\_ next)))))

; --- Re-export the safe io_* / puts names into root scope ---
(namespace _)
(export io)

; --- Consumer-required qualified aliases (bound qualified only, not exported,
;     so no bare `wait`/`read`/`file`/`write_to`/`print`/`done`/`prompt`/`call`
;     leaks into root) ---
(define io.wait     io_wait)
(define io.read     io_read)
(define io.read_all io_read_all)
(define io.file     io_file)
(define io.write_to io_write_to)
(define io.print    io_print)
(define io.done     io_done)
(define io.prompt   io_prompt)
(define io.call     io_call)