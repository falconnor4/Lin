; ==============================================================================
; Lin Standard Library: Binary Trees
; ==============================================================================
; Combines Scott-encoded binary trees (for O(1) left/right destructors)
; and Church trees (for pure self-iterating structural folds).
;
; Every public member carries a globally-safe name so `(export tree)` re-exports
; exactly the consumer API (leaf/node/is_leaf/is_node, the tree_val/tree_left/
; tree_has_*/tree_val_* navigators, and the c_* Church folds) without leaking the
; generic internal accessor names val/left/right into root scope, where they
; would collide with other std modules (e.g. either's left/right).  Those
; accessors are `_`-prefixed and skipped by the export.
; ==============================================================================

(load "bool.lin")

(namespace tree)

; --- Scott tree core ---
(define! leaf a (\l (\n l)))
(define! node (a -> b -> c -> d) (\v (\left (\right (\l (\n (((n v) left) right)))))))
(define! is_leaf (a -> bool) (\t ((t bool.true) (\_ (\_ (\_ bool.false))))))
(define! is_node (a -> bool) (\t ((t bool.false) (\_ (\_ (\_ bool.true))))))

; --- Internal accessors (private, `_`-prefixed; skipped by export) ---
(define! _val (a -> b) (\t ((t 0) (\v (\_ (\_ v))))))
(define! _left (a -> b) (\t ((t tree.leaf) (\_ (\l (\_ l))))))
(define! _right (a -> b) (\t ((t tree.leaf) (\_ (\_ (\r r))))))

; --- Public navigators (globally-safe tree_* names) ---
(define tree_val tree._val)
(define tree_left tree._left)
(define tree_right tree._right)
(define tree_has_left (\t (tree.is_node (tree._left t))))
(define tree_has_right (\t (tree.is_node (tree._right t))))
(define tree_val_left (\t (tree._val (tree._left t))))
(define tree_val_right (\t (tree._val (tree._right t))))

; --- Church Self-Iterating Trees & Folds ---
(define c_leaf (\l (\n l)))
(define c_node (\v (\l (\r (\fl (\fn (((fn v) (l fl fn)) (r fl fn))))))))
(define c_fold (\fl (\fn (\t ((t fl) fn)))))

(namespace _)
(export tree)