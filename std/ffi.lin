; ==============================================================================
; Lin Standard Library: Foreign Function Interface (FFI)
; ==============================================================================
; Direct invocation of native C symbols, system calls, and shared libraries.
; ==============================================================================

(load "list.lin")

(namespace ffi)

; FFI action is encoded as: (\_ffi (\_ret ((_ffi fn) args)))
(define ffi    (\fn (\args (\_ffi (\_ret ((_ffi fn) args))))))
(define ccall ffi.ffi)

; Core POSIX & System Bindings
(define exit     (\c (ffi.ccall "exit" (cons c nil))))
(define getenv   (\name (ffi.ccall "getenv" (cons name nil))))
(define system   (\cmd (ffi.ccall "system" (cons cmd nil))))
(define load_lib (\lib (ffi.ccall "dlopen" (cons lib nil))))
(define folds    (ffi.ccall "lin_folds" nil))  ; native-driver fold count
(define folded   (ffi.ccall "lin_folded" nil)) ; true once any driver folded

(namespace _)
(export ffi)

; Load I/O module (printing, character streams, file operations)
(load "io.lin")
