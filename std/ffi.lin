; ==============================================================================
; Lin Standard Library: Foreign Function Interface (FFI)
; ==============================================================================
; Direct invocation of native C symbols, system calls, and shared libraries.
; ==============================================================================

(load "list.lin")

(namespace ffi)

; FFI action is encoded as: (\_ffi (\_ret ((_ffi fn) args)))
(define ffi    (\fn (\args (\_ffi (\_ret ((_ffi fn) args))))))
(define ccall0 (\fn (ffi.ffi fn list.nil)))
(define ccall1 (\fn (\a1 (ffi.ffi fn (list.cons a1 list.nil)))))
(define ccall2 (\fn (\a1 (\a2 (ffi.ffi fn (list.cons a1 (list.cons a2 list.nil)))))))
(define ccall3 (\fn (\a1 (\a2 (\a3 (ffi.ffi fn (list.cons a1 (list.cons a2 (list.cons a3 list.nil)))))))))
(define ccall4 (\fn (\a1 (\a2 (\a3 (\a4 (ffi.ffi fn (list.cons a1 (list.cons a2 (list.cons a3 (list.cons a4 list.nil)))))))))))
(define ccall5 (\fn (\a1 (\a2 (\a3 (\a4 (\a5 (ffi.ffi fn (list.cons a1 (list.cons a2 (list.cons a3 (list.cons a4 (list.cons a5 list.nil)))))))))))))

; Core POSIX & System Bindings
(define exit     (\c (ffi.ccall1 "exit" c)))
(define getenv   (\name (ffi.ccall1 "getenv" name)))
(define system   (\cmd (ffi.ccall1 "system" cmd)))
(define load_lib (\lib (ffi.ccall1 "dlopen" lib)))
(define folds    (ffi.ccall0 "lin_folds"))  ; native-driver fold count
(define folded   (ffi.ccall0 "lin_folded")) ; true once any driver folded

(namespace _)
(open ffi)
(define ffi ffi.ffi)
(define ccall0 ffi.ccall0)
(define ccall1 ffi.ccall1)
(define ccall2 ffi.ccall2)
(define ccall3 ffi.ccall3)
(define ccall4 ffi.ccall4)
(define ccall5 ffi.ccall5)
(define exit ffi.exit)
(define getenv ffi.getenv)
(define system ffi.system)
(define load_lib ffi.load_lib)
(define folds ffi.folds)
(define folded ffi.folded)

; Load I/O module (printing, character streams, file operations)
(load "io.lin")
