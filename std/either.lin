; ==============================================================================
; Lin Standard Library: Either / Result Monad (Scott-Encoded)
; ==============================================================================
; Provides disjoint union / error handling types with O(1) destructors.
; ==============================================================================

(load "bool.lin")

(namespace either)

; --- Constructors ---
; A value or an error, as a declared datatype -- the shape of a fallible result.  (Scott order as before:
; left, then right.)  By convention `right` is the success and `left` the error.
(datatype (Either a b) (left (l a)) (right (r b)))

(define is_left  (\e (match e ((left x) bool.true) ((right y) bool.false))))
(define is_right (\e (match e ((left x) bool.false) ((right y) bool.true))))

(define either      (\fl (\fr (\e (match e ((left x) (fl x)) ((right y) (fr y)))))))
(define either_map  (\f (\e (match e ((left x) (left x)) ((right y) (right (f y)))))))
(define either_bind (\e (\f (match e ((left x) (left x)) ((right y) (f y))))))
(define from_right  (\d (\e (match e ((left x) d) ((right y) y)))))

(namespace _)
(export either)