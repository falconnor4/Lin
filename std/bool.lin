; lin standard library: booleans & conditionals

(define true (\_bt (\_bf _bt)))
(define false (\_bt (\_bf _bf)))
(define not (\b ((b false) true)))
(define and (\a (\b ((a b) false))))
(define or (\a (\b ((a true) b))))
(define xor (\a (\b ((a (not b)) b))))
(define if (\c (\t (\f ((c t) f)))))
(define ifl (\c (\t (\f (((c t) f) 0)))))
