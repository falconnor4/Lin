; lin standard library: boolean satisfiability (SAT) & verification
(load "bool.lin")
(load "pair.lin")
(load "list.lin")

(define! tru bool true)
(define! fls bool false)

; Quantifiers over booleans
(define! exists ((bool -> bool) -> bool) (\p ((or (p tru)) (p fls))))
(define! forall ((bool -> bool) -> bool) (\p ((and (p tru)) (p fls))))

; Clause constructors (disjunctions)
(define clause1 (\a a))
(define clause2 (\a (\b ((or a) b))))
(define clause3 (\a (\b (\c ((or a) ((or b) c))))))
(define clause4 (\a (\b (\c (\d ((or a) ((or b) ((or c) d))))))))
(define or3 clause3)

; Formula connectors (conjunctions)
(define and2 (\a (\b ((and a) b))))
(define and3 (\a (\b (\c ((and ((and a) b)) c)))))
(define and4 (\a (\b (\c (\d ((and ((and ((and a) b)) c)) d))))))
(define and5 (\a (\b (\c (\d (\e ((and ((and ((and ((and a) b)) c)) d)) e)))))))

; Self-reducible single-variable witness probe
(define! probe1 (a -> b)
  (\p (ifl (p tru)
        (\_ (pair true true))
        (\_ (ifl (p fls)
              (\_ (pair true false))
              (\_ (pair false false)))))))

; 2-variable witness extraction
(define! probe2 (a -> b)
  (\p (ifl (exists (p tru))
        (\_ (pair true (pair true (snd (probe1 (p tru))))))
        (\_ (ifl (exists (p fls))
              (\_ (pair true (pair false (snd (probe1 (p fls))))))
              (\_ (pair false (pair false false))))))))

; 3-variable witness extraction
(define! probe3 (a -> b)
  (\p (ifl (exists (\x2 (exists (\x3 (((p tru) x2) x3)))))
        (\_ (pair true (pair true (snd (probe2 (p tru))))))
        (\_ (ifl (exists (\x2 (exists (\x3 (((p fls) x2) x3)))))
              (\_ (pair true (pair false (snd (probe2 (p fls))))))
              (\_ (pair false (pair false (pair false false)))))))))

; 4-variable witness extraction
(define! probe4 (a -> b)
  (\p (ifl (exists (\x2 (exists (\x3 (exists (\x4 ((((p tru) x2) x3) x4)))))))
        (\_ (pair true (pair true (snd (probe3 (p tru))))))
        (\_ (ifl (exists (\x2 (exists (\x3 (exists (\x4 ((((p fls) x2) x3) x4)))))))
              (\_ (pair true (pair false (snd (probe3 (p fls))))))
              (\_ (pair false (pair false (pair false (pair false false))))))))))

; Independent Certificate Verifiers
; Given a formula predicate p and an extracted model w, evaluates p(w) directly.
(define! verify1 (a -> b -> bool) (\p (\w (p w))))
(define! verify2 (a -> b -> bool) (\p (\w (((p (fst w)) (snd w))))))
(define! verify3 (a -> b -> bool) (\p (\w ((((p (fst w)) (fst (snd w))) (snd (snd w)))))))
(define! verify4 (a -> b -> bool)
  (\p (\w ((((p (fst w)) (fst (snd w))) (fst (snd (snd w)))) (snd (snd (snd w)))))))

; 5-variable witness extraction
(define! probe5 (a -> b)
  (\p (ifl (exists (\x2 (exists (\x3 (exists (\x4 (exists (\x5 (((((p tru) x2) x3) x4) x5)))))))))
        (\_ (pair true (pair true (snd (probe4 (p tru))))))
        (\_ (ifl (exists (\x2 (exists (\x3 (exists (\x4 (exists (\x5 (((((p fls) x2) x3) x4) x5)))))))))
              (\_ (pair true (pair false (snd (probe4 (p fls))))))
              (\_ (pair false (pair false (pair false (pair false (pair false false)))))))))))

; 5-variable certificate verifier
(define! verify5 (a -> b -> bool)
  (\p (\w ((((((p (fst w))
                  (fst (snd w)))
                  (fst (snd (snd w))))
                  (fst (snd (snd (snd w)))))
                  (snd (snd (snd (snd w)))))))))
