; lin standard library: functional set (Scott-encoded BST)
(load "bool.lin")
(load "num.lin")
(load "tree.lin")

(define empty_set leaf)
(define is_empty_set is_leaf)
(define set_singleton (\x (((node x) leaf) leaf)))

(define set_insert_left
  (\x (\s
    (if (is_leaf (tree_left s))
      (((node (tree_val s)) (set_singleton x)) (tree_right s))
      (if (eq x (tree_val_left s))
        s
        (if (lt x (tree_val_left s))
          (((node (tree_val s)) (((node (tree_val_left s)) (set_singleton x)) (tree_right (tree_left s)))) (tree_right s))
          (((node (tree_val s)) (((node (tree_val_left s)) (tree_left (tree_left s))) (set_singleton x))) (tree_right s))))))))

(define set_insert_right
  (\x (\s
    (if (is_leaf (tree_right s))
      (((node (tree_val s)) (tree_left s)) (set_singleton x))
      (if (eq x (tree_val_right s))
        s
        (if (lt x (tree_val_right s))
          (((node (tree_val s)) (tree_left s)) (((node (tree_val_right s)) (set_singleton x)) (tree_right (tree_right s))))
          (((node (tree_val s)) (tree_left s)) (((node (tree_val_right s)) (tree_left (tree_right s))) (set_singleton x)))))))))

(define set_insert
  (\x (\s
    (if (is_leaf s)
      (set_singleton x)
      (if (eq x (tree_val s))
        s
        (if (lt x (tree_val s))
          (set_insert_left x s)
          (set_insert_right x s)))))))

(define set_lookup_sub
  (\x (\s
    (if (is_leaf s)
      false
      (if (eq x (tree_val s))
        true
        (if (lt x (tree_val s))
          (if (tree_has_left s)
            (eq x (tree_val_left s))
            false)
          (if (tree_has_right s)
            (eq x (tree_val_right s))
            false)))))))

(define set_member
  (\x (\s
    (if (is_leaf s)
      false
      (if (eq x (tree_val s))
        true
        (if (lt x (tree_val s))
          (set_lookup_sub x (tree_left s))
          (set_lookup_sub x (tree_right s))))))))
