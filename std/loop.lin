; ==================================================================
; Lin stdlib: iteration.
;
;   (iter cn f z)  ==  ((cn f) z)  ==  f^cn (z)      ; unary step f: acc -> acc
;     cn : a Church count, e.g. c_zero, (c_succ c_zero), or (church N)
;   (church N)     is a parse-time Church numeral (the term \f\x. f^N x).
;   So  (iter (church 5) f z)  applies f 5 times.
;
; Both reduce to concrete values for unary steps.  (An INDEXED step threaded
; through a shared lambda is a dancer-reducer read-back gap; see
; docs/readback-milestone.md.)
; ==================================================================

(define iter (\cn (\f (\z ((cn f) z)))))