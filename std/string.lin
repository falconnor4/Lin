; ==============================================================================
; Lin Standard Library: String Manipulation & Character Combinators
; ==============================================================================
; Scott/Church character sequences, terminating-recursion string concatenation
; and length, and character-by-character equality via the lin_streq FFI.
;
; Every public member below carries the globally-safe `str_*` / `streq` names
; (never bare `empty`/`is_empty`/`head`/`tail`/`first`/`length`/`concat`/`eq`),
; so `(export str)` re-exports exactly those safe names without colliding with
; the bare short names other std modules export.  The few qualified short-name
; references consumers still use (`str.empty`/`str.is_empty`/`str.length`/
; `str.eq`) are bound at root as plain aliases AFTER `(export str)`, so they are
; reachable qualified but never leaked bare.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "list.lin")

(namespace str)

; --- String primitives (reuse the list Scott encodings) ---
(define str_empty   list.nil)
(define str_is_empty list.is_empty)
(define str_head    list.head)
(define str_tail    list.tail)

(define str_char1 list.list1)
(define str_char2 list.list2)
(define str_char3 list.list3)
(define str_char4 list.list4)

(define str_first  list.first)
(define str_second list.second)
(define str_third  list.third)
(define str_fourth list.fourth)

; String length by terminating recursion over the string's tail.
(define str_length
  (\s
    (if (str_is_empty s)
      0
      (num.succ (str_length (str_tail s))))))

; String concatenation by terminating recursion over s1's head/tail.
(define str_concat
  (\s1 (\s2
    (if (str_is_empty s1)
      s2
      (list.cons (list.head s1) (str_concat (list.tail s1) s2))))))

; Character-by-character string equality (FFI).
(define streq (\s1 (\s2 (ccall2 "lin_streq" s1 s2))))
(define str_eq (\s1 (\s2 (ccall2 "lin_streq" s1 s2))))
; --- String -> Scott numeral parsing (pure Lin, no C) ------------------------
; A decimal digit string is a Scott char-list of ASCII codes; parse by peeling
; one char per recursion step: n <- n*10 + (code - 48).  `str_parse_int` folds a
; clean all-digit string to its Scott numeral; empty/invalid input yields `0`.
(define str_is_digit (\c (and (geq c 48) (leq c 57))))
(define! str_parse_int_help (list a -> num -> num) (\s (\n
  (ifl (str_is_empty s)
    (\_ n)
    (\_ (str_parse_int_help (str_tail s) (add (mul n 10) (sub (str_first s) 48))))))))
(define! str_parse_int (list a -> num) (\s
  (ifl (str_is_empty s)
    (\_ 0)
    (\_ (ifl (str_is_digit (str_first s))
          (\_ (str_parse_int_help s 0))
          (\_ 0))))))

; --- Re-export the safe str_* / streq names into root scope ---
(namespace _)
(export str)

; --- Consumer-required qualified aliases (bound qualified only, not exported,
;     so no bare `empty`/`is_empty`/`length`/`eq` leaks into root) ---
(define str.empty   str_empty)
(define str.is_empty str_is_empty)
(define str.length  str_length)
(define str.eq      str_eq)
(define str.parse_int str_parse_int)