; ==============================================================================
; Lin Standard Library: String Manipulation & Character Combinators
; ==============================================================================
; Scott/Church character sequences, terminating-recursion string concatenation
; and length, and character-by-character equality via the lin_streq FFI.
;
; Every public member below carries the globally-safe `str_*` / `streq` names
; (never bare `empty`/`is_empty`/`head`/`tail`/`first`/`length`/`concat`/`eq`),
; so `(export str)` re-exports exactly those safe names without colliding with
; the bare short names other std modules export.  The few qualified short-name
; references consumers still use (`str.empty`/`str.is_empty`/`str.length`/
; `str.eq`) are bound at root as plain aliases AFTER `(export str)`, so they are
; reachable qualified but never leaked bare.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "list.lin")
(load "seq.lin")

(namespace str)

; --- String primitives (reuse the list Scott encodings) ---
(define str_empty   list.nil)
(define str_is_empty list.is_empty)
(define str_head    list.head)
(define str_tail    list.tail)

(define str_char1 list.list1)
(define str_char2 list.list2)
(define str_char3 list.list3)
(define str_char4 list.list4)

(define str_first  list.first)
(define str_second list.second)
(define str_third  list.third)
(define str_fourth list.fourth)

; String length by terminating recursion over the string's tail.
(define str_length
  (\s
    (if (str_is_empty s)
      0
      (num.succ (str_length (str_tail s))))))

; String concatenation by terminating recursion over s1's head/tail.
(define str_concat
  (\s1 (\s2
    (if (str_is_empty s1)
      s2
      (list.cons (list.head s1) (str_concat (list.tail s1) s2))))))

; Character-by-character string equality (FFI).
(define streq (\s1 (\s2 (ccall "lin_streq" (cons s1 (cons s2 nil))))))
(define str_eq (\s1 (\s2 (ccall "lin_streq" (cons s1 (cons s2 nil))))))
; --- String -> Scott numeral parsing (pure Lin, no C) ------------------------
; A decimal digit string is a Scott char-list of ASCII codes; parse by peeling
; one char per recursion step: n <- n*10 + (code - 48).  `str_parse_int` folds a
; clean all-digit string to its Scott numeral; empty/invalid input yields `0`.
(define str_is_digit (\c (and (geq c 48) (leq c 57))))
(define! str_parse_int_help (list a -> num -> num) (\s (\n
  (ifl (str_is_empty s)
    (\_ n)
    (\_ (str_parse_int_help (str_tail s) (add (mul n 10) (sub (str_first s) 48))))))))
(define! str_parse_int (list a -> num) (\s
  (ifl (str_is_empty s)
    (\_ 0)
    (\_ (ifl (str_is_digit (str_first s))
          (\_ (str_parse_int_help s 0))
          (\_ 0))))))

; --- Re-export the safe str_* / streq names into root scope ---;; ---- building and taking apart (all pure Lin; the function compiler reads them as C) ----
; the decimal digits of n (with a leading '-' when negative)
(define _digits (\n (\acc (if (lt n 10) (list.cons (add n 48) acc) (_digits (div n 10) (list.cons (add (mod n 10) 48) acc))))))
(define str_of_num (\n (if (lt n 0) (list.cons 45 (_digits (sub 0 n) list.nil)) (_digits n list.nil))))
(define _rev (\s (\acc (if (str_is_empty s) acc (_rev (list.tail s) (list.cons (list.head s) acc))))))
(define str_reverse (\s (_rev s list.nil)))
(define str_take (\k (\s (if (or (eq k 0) (str_is_empty s)) list.nil (list.cons (list.head s) (str_take (sub k 1) (list.tail s)))))))
(define str_drop (\k (\s (if (or (eq k 0) (str_is_empty s)) s (str_drop (sub k 1) (list.tail s))))))
(define str_equal (\a (\b (if (str_is_empty a) (str_is_empty b)
  (if (str_is_empty b) false (if (eq (list.head a) (list.head b)) (str_equal (list.tail a) (list.tail b)) false))))))
(define _prefix (\p (\s (if (str_is_empty p) true (if (str_is_empty s) false
  (if (eq (list.head p) (list.head s)) (_prefix (list.tail p) (list.tail s)) false))))))
(define str_starts_with (\p (\s (_prefix p s))))
; the position of the first occurrence of p in s, or -1
(define _index (\p (\s (\i (if (_prefix p s) i (if (str_is_empty s) -1 (_index p (list.tail s) (add i 1))))))))
(define str_index_of (\p (\s (_index p s 0))))
; the pieces of s between occurrences of the character c (as a Seq of strings)
(define _split (\c (\s (\cur (if (str_is_empty s) (seq.scons (str_reverse cur) seq.snil)
  (if (eq (list.head s) c) (seq.scons (str_reverse cur) (_split c (list.tail s) list.nil))
    (_split c (list.tail s) (list.cons (list.head s) cur))))))))
(define str_split (\c (\s (_split c s list.nil))))
(define str_lines (\s (str_split 10 s)))
; the words of s: maximal runs of characters that are not space, tab or newline (as a Seq)
(define _ws (\c (or (eq c 32) (or (eq c 10) (or (eq c 9) (eq c 13))))))
(define _words (\s (\cur (if (str_is_empty s) (if (str_is_empty cur) seq.snil (seq.scons (str_reverse cur) seq.snil))
  (if (_ws (list.head s))
    (if (str_is_empty cur) (_words (list.tail s) list.nil) (seq.scons (str_reverse cur) (_words (list.tail s) list.nil)))
    (_words (list.tail s) (list.cons (list.head s) cur)))))))
(define str_words (\s (_words s list.nil)))
; the strings of a Seq, with sep between them
(define str_join (\sep (\ss (seq.sfoldl (\acc (\x (if (str_is_empty acc) x (str_concat acc (str_concat sep x))))) list.nil ss))))

(namespace _)
(export str)

; --- Consumer-required qualified aliases (bound qualified only, not exported,
;     so no bare `empty`/`is_empty`/`length`/`eq` leaks into root) ---
(define str.empty   str_empty)
(define str.is_empty str_is_empty)
(define str.length  str_length)
(define str.eq      str_eq)
(define str.parse_int str_parse_int)