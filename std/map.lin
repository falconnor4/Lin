; ==============================================================================
; Lin Standard Library: Functional Map / Dictionary (BST)
; ==============================================================================
; Functional immutable key-value map built upon binary search trees.
; ==============================================================================

(load "bool.lin")
(load "num.lin")
(load "pair.lin")
(load "maybe.lin")
(load "tree.lin")

(namespace map)
(define empty leaf)
(define is_empty is_leaf)
(define singleton (\k (\v (((node (pair k v)) leaf) leaf))))

(define insert_left
  (\k (\v (\m
    (if (is_leaf (tree_left m))
      (((node (tree_val m)) (singleton k v)) (tree_right m))
      (if (eq k (fst (tree_val_left m)))
        (((node (tree_val m)) (((node (pair k v)) (tree_left (tree_left m))) (tree_right (tree_left m)))) (tree_right m))
        (if (lt k (fst (tree_val_left m)))
          (((node (tree_val m)) (((node (tree_val_left m)) (singleton k v)) (tree_right (tree_left m)))) (tree_right m))
          (((node (tree_val m)) (((node (tree_val_left m)) (tree_left (tree_left m))) (singleton k v))) (tree_right m)))))))))

(define insert_right
  (\k (\v (\m
    (if (is_leaf (tree_right m))
      (((node (tree_val m)) (tree_left m)) (singleton k v))
      (if (eq k (fst (tree_val_right m)))
        (((node (tree_val m)) (tree_left m)) (((node (pair k v)) (tree_left (tree_right m))) (tree_right (tree_right m))))
        (if (lt k (fst (tree_val_right m)))
          (((node (tree_val m)) (tree_left m)) (((node (tree_val_right m)) (singleton k v)) (tree_right (tree_right m))))
          (((node (tree_val m)) (tree_left m)) (((node (tree_val_right m)) (tree_left (tree_right m))) (singleton k v))))))))))

(define insert
  (\k (\v (\m
    (if (is_leaf m)
      (singleton k v)
      (if (eq k (fst (tree_val m)))
        (((node (pair k v)) (tree_left m)) (tree_right m))
        (if (lt k (fst (tree_val m)))
          (insert_left k v m)
          (insert_right k v m))))))))

(define lookup_sub
  (\k (\m
    (if (is_leaf m)
      nothing
      (if (eq k (fst (tree_val m)))
        (just (snd (tree_val m)))
        (if (lt k (fst (tree_val m)))
          (if (tree_has_left m)
            (if (eq k (fst (tree_val_left m)))
              (just (snd (tree_val_left m)))
              nothing)
            nothing)
          (if (tree_has_right m)
            (if (eq k (fst (tree_val_right m)))
              (just (snd (tree_val_right m)))
              nothing)
            nothing)))))))

(define get
  (\k (\m
    (if (is_leaf m)
      nothing
      (if (eq k (fst (tree_val m)))
        (just (snd (tree_val m)))
        (if (lt k (fst (tree_val m)))
          (lookup_sub k (tree_left m))
          (lookup_sub k (tree_right m))))))))

(define get_or (\def_val (\k (\m (from_maybe def_val ((get k) m))))))
(define has (\k (\m (is_just ((get k) m)))))

(namespace _)
(open map)
(define empty_map map.empty)
(define is_empty_map map.is_empty)
(define map_singleton map.singleton)
(define map_insert map.insert)
(define map_insert_left map.insert_left)
(define map_insert_right map.insert_right)
(define map_lookup_sub map.lookup_sub)
(define map_get map.get)
(define map_get_or map.get_or)
(define map_has map.has)
