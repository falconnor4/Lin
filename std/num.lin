; ==============================================================================
; Lin Standard Library: Numerals & Arithmetic
; ==============================================================================
; Scott numerals (O(1) predecessor & pattern matching) + Church numerals (pure
; unbounded self-iterating folds).
;
; Arithmetic & comparison are PURE LIN Scott recursion, wrapped as driver-foldable
; `_op` closures: a saturated op like (add 4 3) reduces to
;     ((\_add <pure-body>) (cons 4 (cons 3 nil)))
; whose head `_add` is a DT_OP-named LAM the reducer's lin_fold_op folds, via the
; shared scalar table (arith.so), into the concrete value whenever the operands
; are concrete — composed uses like (mul 6 (add 24 96)) fold fast.  The embedded
; pure-Scott body is the always-correct β-fallback: with no scalar provider the
; same redex reduces by the interaction calculus (slow but exact).
; ==============================================================================

(load "bool.lin")

(namespace num)

; --- Core Scott Numeral Constructors & Destructors ---
(define! zero num 0)
(define! succ (num -> num) (\n (\_sz (\_ss (_ss n)))))
(define! pred (num -> num) (\n ((n 0) (\p p))))
(define! is_zero (num -> bool) (\n ((n bool.true) (\p bool.false))))

; --- Church Numerals & Self-Iterating Folds ---
(define c_zero (\f (\x x)))
(define c_succ (\n (\f (\x (f (n f x))))))
(define c_add  (\a (\b (\f (\x (a f (b f x)))))))
(define c_mul  (\a (\b (\f (a (b f))))))
(define c_pow  (\b (\e (e b))))
(define c_to_scott (\cn (cn num.succ 0)))

; --- Pure-Lin Scott recursion bodies (the always-correct β fallback) ---
; sub/div/mod clamp like the native table (a<b => 0; /0 or %0 => 0); pow is the
; positive-exponent loop (b=0 => 1), matching arith.so's integer rows.
; The `_cl`-spine operands use the Church-list encodings (`\c \n`) the shared
; on-net decoder recognises, since num.lin loads before list.lin.
(define! _cl_nil  (list a) (\c (\n n)))
(define! _cl_cons (a -> list a -> list a) (\h (\t (\c (\n ((c h) t))))))
(define! _padd (num -> num -> num) (\a (\b (ifl (is_zero a) (\_ b) (\_ (succ (_padd (pred a) b)))))))
(define! _psub (num -> num -> num) (\a (\b (ifl (is_zero b) (\_ a) (\_ (ifl (is_zero a) (\_ 0) (\_ (_psub (pred a) (pred b)))))))))
(define! _pmul (num -> num -> num) (\a (\b (ifl (is_zero a) (\_ 0) (\_ (_padd b (_pmul (pred a) b)))))))
(define! _pdiv (num -> num -> num)
  (\a (\b (ifl (is_zero a) (\_ 0) (\_ (ifl (is_zero b) (\_ 0) (\_ (ifl (lt a b) (\_ 0) (\_ (succ (_pdiv (_psub a b) b)))))))))))
(define! _pmod (num -> num -> num)
  (\a (\b (ifl (is_zero a) (\_ 0) (\_ (ifl (is_zero b) (\_ 0) (\_ (ifl (lt a b) (\_ a) (\_ (_pmod (_psub a b) b))))))))))
(define! _ppow (num -> num -> num)
  (\a (\b (ifl (is_zero b) (\_ 1) (\_ (_pmul a (_ppow a (pred b))))))))
(define! _peq (num -> num -> bool) (\a (\b (ifl (is_zero a) (\_ (is_zero b)) (\_ (ifl (is_zero b) (\_ false) (\_ (_peq (pred a) (pred b)))))))))
(define! _plt (num -> num -> bool) (\a (\b (ifl (is_zero a) (\_ (not (is_zero b))) (\_ (ifl (is_zero b) (\_ false) (\_ (_plt (pred a) (pred b)))))))))
(define _pgt (\a (\b (_plt b a))))
(define _pleq (\a (\b (not (_plt b a)))))
(define _pgeq (\a (\b (not (_plt a b)))))

; --- Arithmetic & Comparison (pure-Lin, driver-foldable) ---
; Each op emits a saturated `_op` closure whose head is a DT_OP-named LAM applied
; to the operand `_cl`-spine, with the pure-Scott body inside (fold / β fallback).
(define! eq (num -> num -> bool) (\a (\b ((\_eq (_peq a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! add (num -> num -> num) (\a (\b ((\_add (_padd a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! sub (num -> num -> num) (\a (\b ((\_sub (_psub a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! mul (num -> num -> num) (\a (\b ((\_mul (_pmul a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! div (num -> num -> num) (\a (\b ((\_div (_pdiv a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! mod (num -> num -> num) (\a (\b ((\_mod (_pmod a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! pow (num -> num -> num) (\a (\b ((\_pow (_ppow a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! lt (num -> num -> bool) (\a (\b ((\_lt (_plt a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! gt (num -> num -> bool) (\a (\b ((\_gt (_pgt a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! leq (num -> num -> bool) (\a (\b ((\_leq (_pleq a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
(define! geq (num -> num -> bool) (\a (\b ((\_geq (_pgeq a b)) (_cl_cons a (_cl_cons b _cl_nil))))))
; Scott aliases
(define zero_s num.zero)
(define succ_s num.succ)
(define pred_s num.pred)
(define is_zero_s num.is_zero)

(namespace _)
(export num)