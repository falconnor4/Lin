; ==============================================================================
; Lin Standard Library: Numerals & Arithmetic
; ==============================================================================
; 64-bit two's complement integers as bit chains (pure Lin, O(64) per op) + Church
; numerals (pure unbounded self-iterating folds).
;
; Arithmetic & comparison are PURE LIN Scott recursion, wrapped as driver-foldable
; `_op` closures: a saturated op like (add 4 3) reduces to
;     ((\_op <pure-body>) (cons <INDEX> (cons 4 (cons 3 nil))))
; whose head is an `_op` LAM the reducer's fold pre-empts, via the shared scalar
; table (arith.so), into the concrete value whenever the operands are concrete —
; composed uses like (mul 6 (add 24 96)) fold fast.  The embedded pure-Scott body
; is the always-correct β-fallback: with no scalar provider the same redex reduces
; by the interaction calculus (slow but exact).
;
; THE OPERAND LIST'S FIRST SLOT IS THE OPERATOR'S INDEX, and that is the whole of
; what says WHICH operator this is: a net carries no label, so `((\_op body) spine)`
; for add and for mul are ONE shape, and the index — a numeral, the encoding this
; language already has for an index — is what tells them apart.  The numbers below
; are std/runtime/pattern.h's LIN_OP_* enumeration, which is where the fold drivers
; read them; a new operator is a row there plus a definition here.
; ==============================================================================

(load "bool.lin")

(namespace num)

; --- 64-bit integers, as net structure ---
; A numeral is a chain of BITS, least significant first: a cell `\c.\n.((c bit) rest)`, ended by a
; terminal `\c.\n.s` whose s is the SIGN -- true: every further bit is 0, false: every further bit is 1.
; So a chain is a two's complement integer, sign-extended; the arithmetic below is int64_t's, wrapping at
; 64 bits (overflow wraps; x/0 = x%0 = 0), the same function std/runtime/i64.h states for the drivers.
; Everything is O(64) bit steps -- no unary recursion -- and needs nothing but the lambda calculus.
(define! zero num 0)
(define cons_  (\h (\t (\c (\n ((c h) t))))))
(define nil_   (\c (\n bool.true)))           ; the non-negative terminal
(define nneg_  (\c (\n bool.false)))          ; the negative terminal
; THE CASE: a cell is handed to `cell`; a terminal's sign selects `pos` or `neg`.
(define _case (\n (\cell (\pos (\neg ((((n (\h (\t (\p (\q ((cell h) t)))))) 0) pos) neg))))))
(define _isterm (\n (_case n (\h (\t bool.false)) bool.true bool.true)))
(define _hd (\n (_case n (\h (\t h)) bool.false bool.true)))          ; a terminal repeats its sign bit
(define _tl (\n (_case n (\h (\t t)) n n)))
(define _sign (\n (_case n (\h (\t (_sign t))) bool.false bool.true))) ; true = negative
(define _bnot (\n (_case n (\h (\t (cons_ (bool.not h) (_bnot t)))) nneg_ nil_)))
; keep at most 64 cells: the 64th bit becomes the sign
(define _fuel (\k (\n (_case k
  (\fh (\ft (_case n (\h (\t (if (_isterm ft) (cons_ h (if h nneg_ nil_)) (cons_ h ((_fuel ft) t))))) n n)))
  n n))))
(define _c2 (\f (\x (f (f x)))))
(define _c64 ((\c8 (\f (c8 (c8 f)))) (\f (_c2 (_c2 (_c2 f)))))) ; Church 64
(define _w64 ((_c64 (cons_ bool.true)) nil_))                  ; 64 cells of fuel
(define _wrap (\n ((_fuel _w64) n)))
; ripple-carry addition with carry-in c; both chains sign-extended by their terminals
(define _xor3 (\a (\b (\c (bool.xor (bool.xor a b) c)))))
(define _maj (\a (\b (\c (bool.or (bool.and a b) (bool.and c (bool.xor a b)))))))
(define _addt (\sa (\sb (\c (if sa
  (if sb (if c nneg_ (cons_ bool.false nneg_)) (if c nil_ nneg_))
  (if sb (if c nil_ nneg_) (if c (cons_ bool.true nil_) nil_)))))))
(define _add (\a (\b (\c (if (bool.and (_isterm a) (_isterm b))
  (_addt (_sign a) (_sign b) c)
  (cons_ (_xor3 (_hd a) (_hd b) c) (_add (_tl a) (_tl b) (_maj (_hd a) (_hd b) c))))))))
(define! _psucc (num -> num) (\n (_wrap (_add n 0 bool.true))))
(define! _ppred (num -> num) (\n (_wrap (_add n (_bnot 0) bool.false))))
(define! _pis_zero (num -> bool) (\n (_case n (\h (\t (if h bool.false (_pis_zero t)))) bool.true bool.false)))
(define! neg (num -> num) (\n (_wrap (_add (_bnot n) 0 bool.true))))

; --- Church Numerals & Self-Iterating Folds ---
(define c_zero (\f (\x x)))
(define c_succ (\n (\f (\x (f (n f x))))))
(define c_add  (\a (\b (\f (\x (a f (b f x)))))))
(define c_mul  (\a (\b (\f (a (b f))))))
(define c_pow  (\b (\e (e b))))
(define c_to_scott (\cn (cn num.succ 0)))

; --- the pure arithmetic (the always-correct fallback a fold driver pre-empts) ---
; The `_cl`-spine operands use the Church-list encodings (`\c \n`) the shared
; on-net decoder recognises, since num.lin loads before list.lin.
(define! _cl_nil  (list a) (\c (\n n)))
(define! _cl_cons (a -> list a -> list a) (\h (\t (\c (\n ((c h) t))))))
(define _abs (\n (if (_sign n) (neg n) n)))
(define _pair (\x (\y (\p ((p x) y)))))
(define _fst (\q (q bool.true)))
(define _snd (\q (q bool.false)))
(define! _padd (num -> num -> num) (\a (\b (_wrap (_add a b bool.false)))))
(define! _psub (num -> num -> num) (\a (\b (_wrap (_add a (_bnot b) bool.true)))))
(define _mulr (\a (\b (_case b (\h (\t (_add (if h a 0) (cons_ bool.false (_mulr a t)) bool.false))) 0 (neg a)))))
(define! _pmul (num -> num -> num) (\a (\b (_wrap (_mulr a b)))))
(define! _plt (num -> num -> bool) (\a (\b (if (bool.xor (_sign a) (_sign b)) (_sign a) (_sign (_psub a b))))))
(define! _peq (num -> num -> bool) (\a (\b (_pis_zero (_psub a b)))))
; unsigned long division of non-negative chains, most significant bit first (the recursion reaches it first)
(define _divu (\a (\b (_case a
  (\h (\t ((\qr ((\r2 (if (_plt r2 b) (_pair (cons_ bool.false (_fst qr)) r2) (_pair (cons_ bool.true (_fst qr)) (_psub r2 b))))
             (cons_ h (_snd qr)))) (_divu t b))))
  (_pair 0 0) (_pair 0 0)))))
(define! _pdiv (num -> num -> num) (\a (\b (if (_pis_zero b) 0
  ((\q (if (bool.xor (_sign a) (_sign b)) (neg q) q)) (_wrap (_fst (_divu (_abs a) (_abs b)))))))))
(define! _pmod (num -> num -> num) (\a (\b (if (_pis_zero b) 0
  ((\r (if (_sign a) (neg r) r)) (_wrap (_snd (_divu (_abs a) (_abs b)))))))))
(define _powr (\a (\e (_case e (\h (\t (_pmul (if h a 1) (_powr (_pmul a a) t)))) 1 1))))
(define! _ppow (num -> num -> num) (\a (\e (if (_sign e)
  (if (_peq a 1) 1 (if (_peq a -1) (if (_hd e) -1 1) 0))
  (_powr a e)))))
(define _pgt (\a (\b (_plt b a))))
(define _pleq (\a (\b (bool.not (_plt b a)))))
(define _pgeq (\a (\b (bool.not (_plt a b)))))

; --- Arithmetic & Comparison (pure-Lin, driver-foldable) ---
; Each op emits a saturated `_op` closure: an `_op` LAM applied to the operand
; `_cl`-spine, whose FIRST slot is the operator index, with the pure-Scott body
; inside (fold / β fallback).  The head is MARKED so that a fold driver can tell it
; from a plain β redex with no label to read: the head's own binder is the ARGUMENT
; of its body's application (`((\_k <pure body>) _op)`), which no ordinary lambda
; shape has (std/runtime/pattern.h lin_pat_op_head is the test).  Applying the head
; to the list β-reduces the marker away, leaving the pure body in its place.
(define! eq (num -> num -> bool) (\a (\b ((\_op ((\_k (_peq a b)) _op)) (_cl_cons 3 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! add (num -> num -> num) (\a (\b ((\_op ((\_k (_padd a b)) _op)) (_cl_cons 0 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! sub (num -> num -> num) (\a (\b ((\_op ((\_k (_psub a b)) _op)) (_cl_cons 2 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! mul (num -> num -> num) (\a (\b ((\_op ((\_k (_pmul a b)) _op)) (_cl_cons 1 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! div (num -> num -> num) (\a (\b ((\_op ((\_k (_pdiv a b)) _op)) (_cl_cons 8 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! mod (num -> num -> num) (\a (\b ((\_op ((\_k (_pmod a b)) _op)) (_cl_cons 9 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! pow (num -> num -> num) (\a (\b ((\_op ((\_k (_ppow a b)) _op)) (_cl_cons 10 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! lt (num -> num -> bool) (\a (\b ((\_op ((\_k (_plt a b)) _op)) (_cl_cons 4 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! gt (num -> num -> bool) (\a (\b ((\_op ((\_k (_pgt a b)) _op)) (_cl_cons 6 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! leq (num -> num -> bool) (\a (\b ((\_op ((\_k (_pleq a b)) _op)) (_cl_cons 5 (_cl_cons a (_cl_cons b _cl_nil)))))))
(define! geq (num -> num -> bool) (\a (\b ((\_op ((\_k (_pgeq a b)) _op)) (_cl_cons 7 (_cl_cons a (_cl_cons b _cl_nil)))))))
; succ / pred / is_zero are the ops above at a constant, so a fold driver sees them as arithmetic
(define! succ (num -> num) (\n (add n 1)))
(define! pred (num -> num) (\n (sub n 1)))
(define! is_zero (num -> bool) (\n (eq n 0)))
; Scott aliases
(define zero_s num.zero)
(define succ_s num.succ)
(define pred_s num.pred)
(define is_zero_s num.is_zero)

(namespace _)
(export num)