; ==============================================================================
; Lin Standard Library: Numerals & Arithmetic
; ==============================================================================
; Combines Scott numerals (for O(1) predecessor & pattern matching) and
; Church numerals (for pure unbounded self-iterating arithmetic folds).
;
; Arithmetic & comparison are DE-LADERED: instead of 10-deep in-net Scott
; windowing ladders, `eq`/`add`/... are thin `ccall2 "lin_*"` FFI closures.
; The engine's confluence-preserving head-fold deferral (net.c) threads each
; operand's computed value into the closure before folding, so composed
; expressions like `(if (geq 1 (min 4 5)) 1 8)` still reduce exactly.
; ==============================================================================

(load "bool.lin")

(namespace num)

; --- Core Scott Numeral Constructors & Destructors ---
(define! zero num 0)
(define! succ (num -> num) (\n (\_sz (\_ss (_ss n)))))
(define! pred (num -> num) (\n ((n 0) (\p p))))
(define! is_zero (num -> bool) (\n ((n bool.true) (\p bool.false))))

; --- Church Numerals & Self-Iterating Folds ---
(define c_zero (\f (\x x)))
(define c_succ (\n (\f (\x (f (n f x))))))
(define c_add  (\a (\b (\f (\x (a f (b f x)))))))
(define c_mul  (\a (\b (\f (a (b f))))))
(define c_pow  (\b (\e (e b))))
(define c_to_scott (\cn (cn num.succ 0)))

(load "ffi.lin")

; --- Arithmetic & Comparison (de-ladered: direct FFI) ---
(define! eq (num -> num -> bool) (\a (\b (ccall2 "lin_eq" a b))))
(define! add (num -> num -> num) (\a (\b (ccall2 "lin_add" a b))))
(define! sub (num -> num -> num) (\a (\b (ccall2 "lin_sub" a b))))
(define! mul (num -> num -> num) (\a (\b (ccall2 "lin_mul" a b))))
(define! div (num -> num -> num) (\a (\b (ccall2 "lin_div" a b))))
(define! mod (num -> num -> num) (\a (\b (ccall2 "lin_mod" a b))))
(define! pow (num -> num -> num) (\a (\b (ccall2 "lin_pow" a b))))

; --- Hybrid Comparisons (de-ladered: direct FFI) ---
(define! lt (num -> num -> bool) (\a (\b (ccall2 "lin_lt" a b))))
(define! gt (num -> num -> bool) (\a (\b (ccall2 "lin_gt" a b))))
(define! leq (num -> num -> bool) (\a (\b (ccall2 "lin_leq" a b))))
(define! geq (num -> num -> bool) (\a (\b (ccall2 "lin_geq" a b))))
; Scott aliases
(define zero_s num.zero)
(define succ_s num.succ)
(define pred_s num.pred)
(define is_zero_s num.is_zero)

(namespace _)
(open num)
(define! zero num num.zero)
(define! succ (num -> num) num.succ)
(define! pred (num -> num) num.pred)
(define! is_zero (num -> bool) num.is_zero)
(define! eq (num -> num -> bool) num.eq)
(define! add (num -> num -> num) num.add)
(define! sub (num -> num -> num) num.sub)
(define! mul (num -> num -> num) num.mul)
(define! div (num -> num -> num) num.div)
(define! mod (num -> num -> num) num.mod)
(define! pow (num -> num -> num) num.pow)
(define! lt  (num -> num -> bool) num.lt)
(define! leq (num -> num -> bool) num.leq)
(define! gt  (num -> num -> bool) num.gt)
(define! geq (num -> num -> bool) num.geq)
(define zero_s num.zero_s)
(define succ_s num.succ_s)
(define pred_s num.pred_s)
(define is_zero_s num.is_zero_s)
(define c_zero num.c_zero)
(define c_succ num.c_succ)
(define c_add num.c_add)
(define c_mul num.c_mul)
(define c_pow num.c_pow)
(define c_to_scott num.c_to_scott)
