; lin standard library: numbers (Scott numerals & FFI arithmetic)
(load "bool.lin")
(load "ffi.lin")

(define! zero num 0)
(define! succ (num -> num) (\n (\_sz (\_ss (_ss n)))))
(define! pred (num -> num) (\n ((n 0) (\p p))))
(define! is_zero (num -> bool) (\n ((n true) (\p false))))

; Hybrid equality: pure in-net reduction for 0..5, FFI for >= 6
(define! eq (num -> num -> bool)
  (\a (\b
    ((a (is_zero b))
      (\pa ((b false)
        (\pb ((pa (is_zero pb))
          (\ppa ((pb false)
            (\ppb ((ppa (is_zero ppb))
              (\pppa ((ppb false)
                (\pppb ((pppa (is_zero pppb))
                  (\ppppa ((pppb false)
                    (\ppppb ((ppppa (is_zero ppppb))
                      (\pppppa ((ppppb false)
                        (\pppppb ((pppppa (is_zero pppppb))
                          (\_ (ccall2 "lin_eq" a b))))))))))))))))))))))))))

; Hybrid arithmetic: pure in-net reduction for 0..4, FFI for larger
(define! add (num -> num -> num)
  (\a (\b
    ((a b)
      (\pa ((pa (succ b))
        (\ppa ((ppa (succ (succ b)))
          (\pppa ((pppa (succ (succ (succ b))))
            (\ppppa ((ppppa (succ (succ (succ (succ b)))))
              (\_ (ccall2 "lin_add" a b))))))))))))))
(define! sub (num -> num -> num) (\a (\b (ccall2 "lin_sub" a b))))
(define! mul (num -> num -> num) (\a (\b (ccall2 "lin_mul" a b))))
(define! div (num -> num -> num) (\a (\b (ccall2 "lin_div" a b))))
(define! mod (num -> num -> num) (\a (\b (ccall2 "lin_mod" a b))))
(define! lt  (num -> num -> bool) (\a (\b (ccall2 "lin_lt" a b))))
(define! leq (num -> num -> bool) (\a (\b (ccall2 "lin_leq" a b))))
(define! gt  (num -> num -> bool) (\a (\b (ccall2 "lin_gt" a b))))
(define! geq (num -> num -> bool) (\a (\b (leq b a))))

; Scott aliases
(define zero_s zero)
(define succ_s succ)
(define pred_s pred)
(define is_zero_s is_zero)
