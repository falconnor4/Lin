; ==============================================================================
; Lin Standard Library: Numerals & Arithmetic
; ==============================================================================
; Combines Scott numerals (for O(1) predecessor & pattern matching) and
; Church numerals (for pure unbounded self-iterating arithmetic folds).
; ==============================================================================

(load "bool.lin")

(namespace num)

; --- Core Scott Numeral Constructors & Destructors ---
(define! zero num 0)
(define! succ (num -> num) (\n (\_sz (\_ss (_ss n)))))
(define! pred (num -> num) (\n ((n 0) (\p p))))
(define! is_zero (num -> bool) (\n ((n bool.true) (\p bool.false))))

; --- Church Numerals & Self-Iterating Folds ---
(define c_zero (\f (\x x)))
(define c_succ (\n (\f (\x (f (n f x))))))
(define c_add  (\a (\b (\f (\x (a f (b f x)))))))
(define c_mul  (\a (\b (\f (a (b f))))))
(define c_pow  (\b (\e (e b))))
(define c_to_scott (\cn (cn num.succ 0)))

(load "ffi.lin")

; --- Hybrid Equality (Pure in-net 0..10, FFI fallback) ---
(define! eq (num -> num -> bool)
  (\a (\b
    ((a (num.is_zero b))
      (\pa ((b bool.false)
        (\pb ((pa (num.is_zero pb))
          (\ppa ((pb bool.false)
            (\ppb ((ppa (num.is_zero ppb))
              (\p3a ((ppb bool.false)
                (\p3b ((p3a (num.is_zero p3b))
                  (\p4a ((p3b bool.false)
                    (\p4b ((p4a (num.is_zero p4b))
                      (\p5a ((p4b bool.false)
                        (\p5b ((p5a (num.is_zero p5b))
                          (\p6a ((p5b bool.false)
                            (\p6b ((p6a (num.is_zero p6b))
                              (\p7a ((p6b bool.false)
                                (\p7b ((p7a (num.is_zero p7b))
                                  (\p8a ((p7b bool.false)
                                    (\p8b ((p8a (num.is_zero p8b))
                                      (\p9a ((p8b bool.false)
                                        (\p9b ((p9a (num.is_zero p9b))
                                          (\p10a ((p9b bool.false)
                                            (\p10b ((p10a (num.is_zero p10b))
                                              (\_ (ccall2 "lin_eq" a b))))))))))))))))))))))))))))))))))))))))))))))

; --- Hybrid Arithmetic (Pure in-net 0..10, FFI fallback) ---
(define! add (num -> num -> num)
  (\a (\b
    ((a b)
      (\pa ((pa (num.succ b))
        (\ppa ((ppa (num.succ (num.succ b)))
          (\p3a ((p3a (num.succ (num.succ (num.succ b))))
            (\p4a ((p4a (num.succ (num.succ (num.succ (num.succ b)))))
              (\p5a ((p5a (num.succ (num.succ (num.succ (num.succ (num.succ b))))))
                (\p6a ((p6a (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ b)))))))
                  (\p7a ((p7a (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ b))))))))
                    (\p8a ((p8a (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ b)))))))))
                      (\p9a ((p9a (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ b))))))))))
                        (\p10a ((p10a (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ (num.succ b)))))))))))
                          (\_ (ccall2 "lin_add" a b))))))))))))))))))))))))))

(define! sub (num -> num -> num)
  (\a (\b
    ((b a)
      (\pb ((pb (num.pred a))
        (\ppb ((ppb (num.pred (num.pred a)))
          (\p3b ((p3b (num.pred (num.pred (num.pred a))))
            (\p4b ((p4b (num.pred (num.pred (num.pred (num.pred a)))))
              (\p5b ((p5b (num.pred (num.pred (num.pred (num.pred (num.pred a))))))
                (\p6b ((p6b (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred a)))))))
                  (\p7b ((p7b (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred a))))))))
                    (\p8b ((p8b (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred a)))))))))
                      (\p9b ((p9b (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred a))))))))))
                        (\p10b ((p10b (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred (num.pred a)))))))))))
                          (\_ (ccall2 "lin_sub" a b))))))))))))))))))))))))))

(define! mul (num -> num -> num)
  (\a (\b
    ((a 0)
      (\pa ((pa b)
        (\ppa ((ppa ((num.add b) b))
          (\p3a ((p3a ((num.add b) ((num.add b) b)))
            (\p4a ((p4a ((num.add b) ((num.add b) ((num.add b) b))))
              (\p5a ((p5a ((num.add b) ((num.add b) ((num.add b) ((num.add b) b)))))
                (\p6a ((p6a ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) b))))))
                  (\p7a ((p7a ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) b)))))))
                    (\p8a ((p8a ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) b))))))))
                      (\p9a ((p9a ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) b)))))))))
                        (\p10a ((p10a ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) ((num.add b) b))))))))))
                          (\_ (ccall2 "lin_mul" a b))))))))))))))))))))))))))

(define! div (num -> num -> num) (\a (\b (ccall2 "lin_div" a b))))
(define! mod (num -> num -> num) (\a (\b (ccall2 "lin_mod" a b))))
(define! pow (num -> num -> num) (\a (\b (ccall2 "lin_pow" a b))))

; --- Hybrid Comparisons (Pure in-net 0..10, FFI fallback) ---
(define! lt (num -> num -> bool)
  (\a (\b
    ((a (bool.not (num.is_zero b)))
      (\pa ((b bool.false)
        (\pb ((pa (bool.not (num.is_zero pb)))
          (\ppa ((pb bool.false)
            (\ppb ((ppa (bool.not (num.is_zero ppb)))
              (\p3a ((ppb bool.false)
                (\p3b ((p3a (bool.not (num.is_zero p3b)))
                  (\p4a ((p3b bool.false)
                    (\p4b ((p4a (bool.not (num.is_zero p4b)))
                      (\p5a ((p4b bool.false)
                        (\p5b ((p5a (bool.not (num.is_zero p5b)))
                          (\p6a ((p5b bool.false)
                            (\p6b ((p6a (bool.not (num.is_zero p6b)))
                              (\p7a ((p6b bool.false)
                                (\p7b ((p7a (bool.not (num.is_zero p7b)))
                                  (\p8a ((p7b bool.false)
                                    (\p8b ((p8a (bool.not (num.is_zero p8b)))
                                      (\p9a ((p8b bool.false)
                                        (\p9b ((p9a (bool.not (num.is_zero p9b)))
                                          (\p10a ((p9b bool.false)
                                            (\p10b ((p10a (bool.not (num.is_zero p10b)))
                                              (\_ (ccall2 "lin_lt" a b))))))))))))))))))))))))))))))))))))))))))))))

(define! gt  (num -> num -> bool) (\a (\b ((num.lt b) a))))
(define! leq (num -> num -> bool) (\a (\b (bool.not ((num.lt b) a)))))
(define! geq (num -> num -> bool) (\a (\b (bool.not ((num.lt a) b)))))

; Scott aliases
(define zero_s num.zero)
(define succ_s num.succ)
(define pred_s num.pred)
(define is_zero_s num.is_zero)

(namespace _)
(open num)
(define! zero num num.zero)
(define! succ (num -> num) num.succ)
(define! pred (num -> num) num.pred)
(define! is_zero (num -> bool) num.is_zero)
(define! eq (num -> num -> bool) num.eq)
(define! add (num -> num -> num) num.add)
(define! sub (num -> num -> num) num.sub)
(define! mul (num -> num -> num) num.mul)
(define! div (num -> num -> num) num.div)
(define! mod (num -> num -> num) num.mod)
(define! pow (num -> num -> num) num.pow)
(define! lt  (num -> num -> bool) num.lt)
(define! leq (num -> num -> bool) num.leq)
(define! gt  (num -> num -> bool) num.gt)
(define! geq (num -> num -> bool) num.geq)
(define zero_s num.zero_s)
(define succ_s num.succ_s)
(define pred_s num.pred_s)
(define is_zero_s num.is_zero_s)
(define c_zero num.c_zero)
(define c_succ num.c_succ)
(define c_add num.c_add)
(define c_mul num.c_mul)
(define c_pow num.c_pow)
(define c_to_scott num.c_to_scott)
