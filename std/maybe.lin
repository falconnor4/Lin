; ==============================================================================
; Lin Standard Library: Maybe / Option Monad (Scott-Encoded)
; ==============================================================================
; Provides option types with O(1) case analysis and monadic operations.
; ==============================================================================

(load "bool.lin")

(namespace maybe)

; --- Constructors ---
(define nothing (\n (\j n)))
(define just    (\x (\n (\j (j x)))))

; --- Predicates ---
(define is_nothing (\m ((m bool.true) (\_ bool.false))))
(define is_just    (\m ((m bool.false) (\_ bool.true))))

; --- Eliminators & Combinators ---
(define from_maybe (\d (\m ((m d) (\x x)))))
(define maybe_map  (\f (\m ((m maybe.nothing) (\x (maybe.just (f x)))))))
(define maybe_bind (\m (\f ((m maybe.nothing) (\x (f x))))))
(define maybe_or   (\m1 (\m2 ((m1 m2) (\x (maybe.just x))))))

(namespace _)
(export maybe)