; lin standard library: maybe / option type (Scott-encoded)
(load "bool.lin")

(define nothing (\n (\j n)))
(define just (\x (\n (\j (j x)))))
(define is_nothing (\m ((m true) (\_ false))))
(define is_just (\m ((m false) (\_ true))))
(define from_maybe (\d (\m ((m d) (\x x)))))
(define maybe_map (\f (\m ((m nothing) (\x (just (f x)))))))
(define maybe_bind (\m (\f ((m nothing) (\x (f x))))))
(define maybe_or (\m1 (\m2 ((m1 m2) (\x (just x))))))
