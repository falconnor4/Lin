; ==============================================================================
; Lin Standard Library: Maybe / Option Monad (Scott-Encoded)
; ==============================================================================
; Provides option types with O(1) case analysis and monadic operations.
; ==============================================================================

(load "bool.lin")

(namespace maybe)

; --- Constructors ---
(define nothing (\n (\j n)))
(define just    (\x (\n (\j (j x)))))

; --- Predicates ---
(define is_nothing (\m ((m bool.true) (\_ bool.false))))
(define is_just    (\m ((m bool.false) (\_ bool.true))))

; --- Eliminators & Combinators ---
(define from_maybe (\d (\m ((m d) (\x x)))))
(define map  (\f (\m ((m maybe.nothing) (\x (maybe.just (f x)))))))
(define bind (\m (\f ((m maybe.nothing) (\x (f x))))))
(define or   (\m1 (\m2 ((m1 m2) (\x (maybe.just x))))))

(namespace _)
(open maybe)
(define nothing maybe.nothing)
(define just maybe.just)
(define is_nothing maybe.is_nothing)
(define is_just maybe.is_just)
(define from_maybe maybe.from_maybe)
(define maybe_map maybe.map)
(define maybe_bind maybe.bind)
(define maybe_or maybe.or)
