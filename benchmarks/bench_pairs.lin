(load "std/std.lin")

; Benchmark: Deep nested pair construction and projection
(define p0 (pair 10 20))
(define p1 (pair (fst p0) (snd p0)))
(define p2 (pair (swap p1) (swap p0)))
(define p3 (pair (fst (fst p2)) (snd (snd p2))))
(define p4 (pair (pair (pair 1 2) (pair 3 4)) (pair (pair 5 6) (pair 7 8))))

(define! main a
  (let ((v1 (fst (snd (fst p4))))
        (v2 (snd (snd (snd p4))))
        (v3 (fst (fst (fst p4))))
        (v4 (snd (fst (snd p4))))
        (v5 (fst p3))
        (v6 (snd p3)))
    (add v1 (add v2 (add v3 (add v4 (add v5 v6)))))))

(main)
