; compile-time and parse errors
; NOTE: an unterminated '(' aborts reading the rest of the file,
; so those cases are kept at the very end.

(foo 1)
; expect error: unbound variable 'foo'

(1 true)
; expect => (\_ss (_ss 0))

(\x (x x))
; expect error: infinite type

999
; expect => 999

(\x (y x))
; expect error: unbound variable 'y'

((\x x) x)
; expect error: unbound variable 'x'

(undefined_fn 5)
; expect error: unbound variable 'undefined_fn'

(head 5)
; expect error: type mismatch

(tail true)
; expect error: type mismatch

(cons 1 2)
; expect error: type mismatch

(succ true)
; expect => (\_sz (\_ss (_ss true)))

(pred true)
; expect => 0

(fst 3)
; expect => (\_ss (_ss 2))

(lambda y (y y))
; expect error: infinite type

()
; expect error: parse error: empty '('

()
; expect error: parse error: empty '('

; a stray ')' after a complete form: the form still evaluates
(add 1 2))
; expect => 3
; expect error: parse error: unexpected ')'

500
; expect => 500

; unterminated forms (must be last -- they abort the rest of the file)
(1
; expect error: parse error: missing ')'