; pairs and lists

(fst (pair 1 2))
; expect => 1

(snd (pair 1 2))
; expect => 2

(is_empty nil)
; expect => true

(is_empty (cons 1 nil))
; expect => false

(head (cons 1 (cons 2 nil)))
; expect => 1

(head (tail (cons 1 (cons 2 nil))))
; expect => 2

; sum a list of length 3
(define sum3 (\l (add (head l) (add (head (tail l)) (head (tail (tail l)))))))
(sum3 (cons 1 (cons 2 (cons 3 nil))))
; expect => 6

; --- more list primitives ---
(cons 1 nil)
; expect => (\c (\n ((c 1) (\c (\n true)))))

(tail (cons 1 (cons 2 nil)))
; expect => (\...

(tail (tail (cons 1 (cons 2 nil))))
; expect => (\c (\n true))

(is_empty (cons 7 nil))
; expect => false

(head (tail (tail (cons 1 (cons 2 (cons 3 nil))))))
; expect => 3

(head (cons (add 1 2) nil))
; expect => 3

(eq (head (cons 5 nil)) 5)
; expect => true

; sum of a length-4 list
(define sum4 (\l (add (head l) (add (head (tail l)) (add (head (tail (tail l))) (head (tail (tail (tail l)))))))))
(sum4 (cons 1 (cons 2 (cons 3 (cons 4 nil)))))
; expect => 10

(sum3 (cons 5 (cons 6 (cons 7 nil))))
; expect => 18

; --- recursive list functions ---
(define lsum (\l (ifl (is_empty l) (\_ 0) (\_ (add (head l) (lsum (tail l)))))))
(lsum (cons 1 (cons 2 nil)))
; expect => 3

(define llen (\l (ifl (is_empty l) (\_ 0) (\_ (add 1 (llen (tail l)))))))
(llen (cons 1 (cons 2 nil)))
; expect => 2

(define lmax (\l (ifl (is_empty (tail l)) (\_ (head l)) (\_ (ifl (gt (head l) (head (tail l))) (\_ (lmax (cons (head l) (tail (tail l))))) (\_ (lmax (tail l))))))))
(lmax (cons 3 nil))
; expect => 3
(lmax (cons 3 (cons 1 nil)))
; expect => 3