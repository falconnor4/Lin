; pairs and lists

(fst (pair 1 2))
; expect => 1

(snd (pair 1 2))
; expect => 2

(is_empty nil)
; expect => true

(is_empty (cons 1 nil))
; expect => false

(head (cons 1 (cons 2 nil)))
; expect => 1

(head (tail (cons 1 (cons 2 nil))))
; expect => 2

; sum a list of length 3
(define sum3 (\l (add (head l) (add (head (tail l)) (head (tail (tail l)))))))
(sum3 (cons 1 (cons 2 (cons 3 nil))))
; expect => 6

; --- more list primitives ---
(cons 65 nil)
; expect => "A"

(head (tail (cons 1 (cons 2 nil))))
; expect => 2

(is_empty (tail (tail (cons 1 (cons 2 nil)))))
; expect => true

(is_empty (cons 7 nil))
; expect => false

(head (tail (tail (cons 1 (cons 2 (cons 3 nil))))))
; expect => 3

(head (cons (add 1 2) nil))
; expect => 3

(eq (head (cons 5 nil)) 5)
; expect => true

; sum of a length-4 list
(define sum4 (\l (add (head l) (add (head (tail l)) (add (head (tail (tail l))) (head (tail (tail (tail l)))))))))
(sum4 (cons 1 (cons 2 (cons 3 (cons 4 nil)))))
; expect => 10

(sum3 (cons 5 (cons 6 (cons 7 nil))))
; expect => 18

; --- positional projections (first .. fifth) ---
(define l5 (cons 10 (cons 20 (cons 30 (cons 40 (cons 50 nil))))))
(first l5)
; expect => 10

(second l5)
; expect => 20

(third l5)
; expect => 30

(fourth l5)
; expect => 40

(fifth l5)
; expect => 50