; booleans

true
; expect => true

false
; expect => false

(not true)
; expect => false

(not false)
; expect => true

(and true false)
; expect => false

(and true true)
; expect => true

(or false true)
; expect => true

(or false false)
; expect => false

(xor true true)
; expect => false

(xor true false)
; expect => true

(xor false true)
; expect => true

(xor false false)
; expect => false

(if true 1 2)
; expect => 1

(if false 1 2)
; expect => 2

(if (is_zero 0) (add 1 1) 3)
; expect => 2

; --- derived boolean identities ---
(not (not true))
; expect => true

(not (not false))
; expect => false

(and false true)
; expect => false

(and false false)
; expect => false

(or true true)
; expect => true

(or true false)
; expect => true

(and (not false) true)
; expect => true

(or (not true) false)
; expect => false

(xor (not true) false)
; expect => false

(xor true (not true))
; expect => true

(if true 5 6)
; expect => 5

(if false 5 6)
; expect => 6

(if (not (is_zero 3)) 7 8)
; expect => 7

(if (is_zero 0) false true)
; expect => false

(if (not false) (if true 1 2) 3)
; expect => 1

(eq (if (eq 1 1) 1 0) 1)
; expect => true

(if (and true true) 3 4)
; expect => 3

(if (xor true true) 1 2)
; expect => 2