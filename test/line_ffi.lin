; Standalone portable .line binary: FFI arithmetic + shared (croissant) values.
; Exercises that `lin build` -> `.line` -> run preserves FFI closures and the
; shared-subnet (GoI sharing) structure needed by duplicated computations.
(load "std/std.lin")

; Shared subterm: `sq` feeds two independent uses, so the net shares it.
(define sq (\a (mul a a)))
(define! main a
  (let ((x (sq 6))                     ; 36, shared by the two uses below
        (y (add 1 2)))
    (io_print "FFI_LINE_OK: "
      (io_print (add x (mul y x))
        (io_print "\n" 0)))))

(main)