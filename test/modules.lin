; Comprehensive test suite for Lin modules, namespaces, and scoping

(load "std/std.lin")

; 1. Basic namespace definition and qualified access
(namespace test_a)
(define x 100)
(define add10 (\n (add n 10)))
(namespace _)

test_a.x
; expect => 100

(test_a.add10 5)
; expect => 15

; 2. Multiple namespaces with identical identifier names (no collisions)
(namespace test_b)
(define x 200)
(define add10 (\n (add n 20)))
(namespace _)

test_b.x
; expect => 200

(test_b.add10 5)
; expect => 25

; Qualified access to test_a.x still unchanged
test_a.x
; expect => 100

; 3. Opening namespaces
(open test_a)
x
; expect => 100

(add10 5)
; expect => 15

; 4. Opening test_b shadows or takes priority for open lookup
(open test_b)
x
; expect => 200

(add10 5)
; expect => 25

; Explicit qualification always resolves precisely
test_a.x
; expect => 100
test_b.x
; expect => 200

; 5. Standard library namespaced functions
(math.min 3 7)
; expect => 3

(math.max 3 7)
; expect => 7

(math.sqr 6)
; expect => 36

(str.is_empty str.empty)
; expect => true

(str.length "hello")
; expect => 5

; 6. Church self-iterating folds in list module
(define cl (list.c_cons 1 (list.c_cons 2 (list.c_cons 3 list.c_nil))))
(list.c_length cl)
; expect => 3

(define sl (list.c_to_scott cl))
(head sl)
; expect => 1
(head (tail sl))
; expect => 2
(head (tail (tail sl)))
; expect => 3

; 7. Church self-iterating stream operations
(define s (stream.nats 0))
(define c4 (\f (\x (f (f (f (f x)))))))
(stream.nth_c c4 s)
; expect => 4

; 8. Nested FFI arithmetic resolution (issue 2)
(div (mul 150 150) 100)
; expect => 225

; 9. FFI Boolean correctness with Church combinators (issue 1)
(io_wait (ccall2 "lin_eq" 42 42) (\b (io_print (if b 10 20) (io_print "\n" io_done))))
; expect 10

(io_wait (ccall2 "lin_eq" 42 43) (\b (io_print (if b 10 20) (io_print "\n" io_done))))
; expect 20

(io_wait (ccall2 "lin_eq" 42 43) (\b (io_print (not b) (io_print "\n" io_done))))
; expect true

; 10. String literal escape sequences (issue 5)
(str.length "\e[31mLin\e[0m")
; expect => 8

(str.length "\033[32m")
; expect => 5

; 11. String equality via str.eq / list.eq (issue 6)
(str.eq "hello" "hello")
; expect => true

(str.eq "hello" "world")
; expect => false

(str_eq "foo" "foo")
; expect => true

; 12. Deep definition expansion DAG (issue 4)
(define t1 (\x (add x x)))
(define t2 (\x (t1 (t1 x))))
(define t3 (\x (t2 (t2 x))))
(t3 1)
; expect => 16

