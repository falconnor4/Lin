; datatype & match: user-declared Scott-encoded ADTs + pattern dispatch

(datatype List (nil) (cons head tail))

(match (cons 1 (cons 2 nil))
  (nil 0)
  ((cons h t) (add h 10)))
; expect => 11

(match (cons 3 (cons 2 nil))
  (nil 0)
  ((cons h t) (add h 2)))
; expect => 5

(match nil
  (nil 7)
  ((cons h t) 0))
; expect => 7

(match (cons 1 nil)
  (nil 7)
  ((cons h t) (mul h 6)))
; expect => 6

; A 3-constructor ADT exercises multi-way dispatch.
(datatype Option (none) (some val) (err msg))
(match (some 5) (none 0) ((some v) v) ((err m) 9))
; expect => 5
(match (err "x") (none 0) ((some v) v) ((err m) 13))
; expect => 13
(match none (none 7) ((some v) 0) ((err m) 0))
; expect => 7

; A RECURSIVE datatype traversed by a recursive function: `match` is typed over the datatype (the
; scrutinee is a Tree, a branch is "the constructor's fields -> the result"), not as a bare application,
; which made the parameter's type an arrow mentioning itself (an infinite type).
(datatype Tree (leaf) (node l r))
(define make_tree (\d (if (eq d 0) leaf (node (make_tree (sub d 1)) (make_tree (sub d 1))))))
(define count_tree (\t (match t (leaf 1) ((node l r) (add 1 (add (count_tree l) (count_tree r)))))))
(count_tree (make_tree 3))
; expect => 15
(datatype Bst (tip) (bin k l r))
(define bst_ins (\x (\t (match t (tip (bin x tip tip)) ((bin k l r) (if (lt x k) (bin k (bst_ins x l) r) (bin k l (bst_ins x r))))))))
(define bst_sum (\t (match t (tip 0) ((bin k l r) (add k (add (bst_sum l) (bst_sum r)))))))
(bst_sum (bst_ins 5 (bst_ins 2 (bst_ins 9 tip))))
; expect => 16
; A datatype's value prints by its constructors' names (the marker each constructor carries).
(datatype Opt (nothing) (just x))
(just 5)
; expect => (just 5)
nothing
; expect => nothing
(just (just 3))
; expect => (just (just 3))
(bin 2 tip (bin 9 tip tip))
; expect => (bin 2 tip (bin 9 tip tip))
; A value computed by a recursive function prints by its type: the declared field types say what each field is.
(datatype (Lst a) (lnil_) (lcons_ (h a) (t Lst a)))
(define upto_ (\n (if (eq n 0) lnil_ (lcons_ n (upto_ (sub n 1))))))
(upto_ 3)
; expect => (lcons_ 3 (lcons_ 2 (lcons_ 1 lnil_)))
; an undeclared field that is the enclosing datatype prints as one too
(define mk_tree (\n (if (eq n 0) tip (bin n (mk_tree (sub n 1)) tip))))
(mk_tree 2)
; expect => (bin 2 (bin 1 tip tip) tip)
