; recursion and bounded iteration test suite with thunked ifl

; --- factorial (stratified single-recursion step) ---
(define! fact_step ((num -> num) -> num -> num)
  (\rec (\n (ifl (is_zero n) (\_ 1) (\_ (mul n (rec (pred n))))))))

(define fact (fact_step (fact_step (fact_step (fact_step (fact_step (\_ 1)))))))
(fact 0)
; expect => 1
(fact 1)
; expect => 1
(fact 2)
; expect => 2
(fact 3)
; expect => 6
(fact 4)
; expect => 24

(define double (\n (add n n)))
(double 21)
; expect => 42

; --- fibonacci (linear state-transition iteration) ---
(define fib_step (\p (pair (snd p) (add (fst p) (snd p)))))
(define fib0 (pair 0 1))
(define fib1 (fib_step fib0))
(define fib2 (fib_step fib1))
(define fib3 (fib_step fib2))
(define fib4 (fib_step fib3))
(define fib5 (fib_step fib4))

(fst fib0)
; expect => 0
(fst fib1)
; expect => 1
(fst fib2)
; expect => 1
(fst fib3)
; expect => 2
(fst fib4)
; expect => 3
(fst fib5)
; expect => 5

; --- arithmetic recursion: triangular numbers (sumto) ---
(define! sumto_step ((num -> num) -> num -> num)
  (\rec (\n (ifl (is_zero n) (\_ 0) (\_ (add n (rec (pred n))))))))
(define sumto (sumto_step (sumto_step (sumto_step (sumto_step (\_ 0))))))

(sumto 0)
; expect => 0
(sumto 1)
; expect => 1
(sumto 2)
; expect => 3
(sumto 3)
; expect => 6

; --- divisibility by 3 via subtraction ---
(define! div3_step ((num -> bool) -> num -> bool)
  (\rec (\n (ifl (lt n 3) (\_ (eq n 0)) (\_ (rec (sub n 3)))))))
(define div3? (div3_step (div3_step (div3_step (\_ false)))))

(div3? 0)
; expect => true
(div3? 3)
; expect => true
(div3? 4)
; expect => false
(div3? 6)
; expect => true

; --- powers of 2 ---
(define! pow2_step ((num -> num) -> num -> num)
  (\rec (\n (ifl (is_zero n) (\_ 1) (\_ (mul 2 (rec (pred n))))))))
(define pow2 (pow2_step (pow2_step (pow2_step (pow2_step (\_ 1))))))

(pow2 0)
; expect => 1
(pow2 1)
; expect => 2
(pow2 2)
; expect => 4
(pow2 3)
; expect => 8

; --- nested double recursion (Ackermann branch unrolling) ---
(define! ack (num -> num -> num)
  (\m (\n (ifl (is_zero m) (\_ (succ n)) (\_ (ifl (eq m 1) (\_ (add n 2)) (\_ 0)))))))

((ack 0) 1)
; expect => 2
((ack 1) 1)
; expect => 3
((ack 1) 2)
; expect => 4