; recursion (automatic Y)

(define fact (\n (if (is_zero n) 1 (mul n (fact (pred n))))))
(fact 0)
; expect => 1
(fact 1)
; expect => 1
(fact 2)
; expect => 2
(fact 3)
; expect => 6
(fact 4)
; expect => 24

(define double (\n (add n n)))
(double 21)
; expect => 42

; --- fibonacci recursion ---
(define fib (\n (if (leq n 1) n (add (fib (sub n 1)) (fib (sub n 2))))))
(fib 0)
; expect => 0
(fib 1)
; expect => 1
(fib 2)
; expect => 1

; --- arithmetic recursion ---
(define sumto (\n (if (is_zero n) 0 (add n (sumto (pred n))))))
(sumto 0)
; expect => 0
(sumto 1)
; expect => 1
(sumto 2)
; expect => 3
(sumto 3)
; expect => 6

(define div3? (\n (if (lt n 3) (eq n 0) (div3? (sub n 3)))))
(div3? 0)
; expect => true
(div3? 3)
; expect => true
(div3? 4)
; expect => false

(define pow2 (\n (if (is_zero n) 1 (mul 2 (pow2 (pred n))))))
(pow2 0)
; expect => 1
(pow2 1)
; expect => 2
(pow2 2)
; expect => 4
(pow2 3)
; expect => 8

; --- nested double recursion ---
(define ack (\m (\n (if (is_zero m) (succ n) (if (is_zero n) (ack (pred m) 1) (ack (pred m) (ack m (pred n))))))))
((ack 0) 1)
; expect => 2
((ack 1) 1)
; expect => 3
((ack 1) 2)
; expect => 4