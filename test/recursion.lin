; recursion (automatic Y) with thunked ifl

(define fact (\n (ifl (is_zero n) (\_ 1) (\_ (mul n (fact (pred n)))))))
(fact 0)
; expect => 1
(fact 1)
; expect => 1
(fact 2)
; expect => 2
(fact 3)
; expect => 6
(fact 4)
; expect => 24

(define double (\n (add n n)))
(double 21)
; expect => 42

; --- fibonacci recursion ---
(define fib (\n (ifl (leq n 1) (\_ n) (\_ (add (fib (sub n 1)) (fib (sub n 2)))))))
(fib 0)
; expect => 0
(fib 1)
; expect => 1
(fib 2)
; expect => 1

; --- arithmetic recursion ---
(define sumto (\n (ifl (is_zero n) (\_ 0) (\_ (add n (sumto (pred n)))))))
(sumto 0)
; expect => 0
(sumto 1)
; expect => 1
(sumto 2)
; expect => 3
(sumto 3)
; expect => 6

(define div3? (\n (ifl (lt n 3) (\_ (eq n 0)) (\_ (div3? (sub n 3))))))
(div3? 0)
; expect => true
(div3? 3)
; expect => true
(div3? 4)
; expect => false

(define pow2 (\n (ifl (is_zero n) (\_ 1) (\_ (mul 2 (pow2 (pred n)))))))
(pow2 0)
; expect => 1
(pow2 1)
; expect => 2
(pow2 2)
; expect => 4
(pow2 3)
; expect => 8

; --- nested double recursion ---
(define ack (\m (\n (ifl (is_zero m) (\_ (succ n)) (\_ (ifl (is_zero n) (\_ (ack (pred m) 1)) (\_ (ack (pred m) (ack m (pred n))))))))))
((ack 0) 1)
; expect => 2
((ack 1) 1)
; expect => 3
((ack 1) 2)
; expect => 4