; strings and character lists test suite

; empty string is empty list
(is_empty "")
; expect => true

(is_empty "a")
; expect => false

(is_empty "hello")
; expect => false

; head extracts first character numeral (ASCII)
(head "A")
; expect => 65

(head "hello")
; expect => 104

(head (tail "hello"))
; expect => 101

(head (tail (tail "hello")))
; expect => 108

(head (tail (tail (tail "hello"))))
; expect => 108

(head (tail (tail (tail (tail "hello")))))
; expect => 111

(is_empty (tail (tail (tail (tail (tail "hello"))))))
; expect => true

; Positional projections on string character lists
(first "hello")
; expect => 104

(second "hello")
; expect => 101

(third "hello")
; expect => 108

(fourth "hello")
; expect => 108

(fifth "hello")
; expect => 111
