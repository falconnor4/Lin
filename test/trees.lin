; Binary Trees test suite (Scott-encoded algebraic data types)

(define! leaf a (\l (\n l)))
(define! node (a -> b -> c -> d) (\v (\left (\right (\l (\n (((n v) left) right)))))))

(define! is_leaf (a -> bool) (\t ((t true) (\_ (\_ (\_ false))))))
(define! val (a -> b) (\t ((t 0) (\v (\_ (\_ v))))))
(define! left (a -> b) (\t ((t leaf) (\_ (\left (\_ left))))))
(define! right (a -> b) (\t ((t leaf) (\_ (\_ (\right right))))))

; Leaf tests
(is_leaf leaf)
; expect => true

; Single node
(define t1 (node 42 leaf leaf))
(is_leaf t1)
; expect => false

(val t1)
; expect => 42

(is_leaf (left t1))
; expect => true

(is_leaf (right t1))
; expect => true

; 3-node tree:   10
;               /  \
;              5    20
(define t3 (node 10 (node 5 leaf leaf) (node 20 leaf leaf)))

(val t3)
; expect => 10

(val (left t3))
; expect => 5

(val (right t3))
; expect => 20

; Tree size and sum helpers
(define! is_node (a -> bool) (\t ((t false) (\_ (\_ (\_ true))))))
(is_node leaf)
; expect => false

(is_node t1)
; expect => true

(is_node (left t3))
; expect => true

(is_node (right t3))
; expect => true

(is_leaf (left (left t3)))
; expect => true

(is_leaf (right (left t3)))
; expect => true

; 3-node sum
(define tsum3 (\t (add (val t) (add (val (left t)) (val (right t))))))
(tsum3 t3)
; expect => 35

; 5-node balanced binary search tree
;        100
;       /   \
;     50     200
;    /  \
;  25    75
(define t5 (node 100 (node 50 (node 25 leaf leaf) (node 75 leaf leaf)) (node 200 leaf leaf)))

(val t5)
; expect => 100

(val (left t5))
; expect => 50

(val (right t5))
; expect => 200

(val (left (left t5)))
; expect => 25

(val (right (left t5)))
; expect => 75

(is_leaf (left (right t5)))
; expect => true

(is_leaf (right (right t5)))
; expect => true
