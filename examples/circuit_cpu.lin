(load "std/std.lin")

; ==============================================================================
; Lin: 8-Bit ALU & Digital Logic Circuit Hardware Simulation
; ==============================================================================
; Demonstrates:
;   1. Gate-level digital logic synthesized directly as interaction nets.
;   2. Universal NAND gates, 1-bit Full Adders, and Ripple-Carry Adders.
;   3. Hardware registers (Accumulator, Operand, Flags: Z, N, C, V).
;   4. Interactive ASCII register and bus inspector.
; ==============================================================================

; --- Pure In-Net Exact Scott Numeral Matchers (0..9) ---
(define! is_0 (num -> bool) (\n ((n bool.true) (\_ bool.false))))
(define! is_1 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.true) (\_ bool.false))))))
(define! is_2 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.true) (\_ bool.false))))))))
(define! is_3 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.true) (\_ bool.false))))))))))
(define! is_4 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.true) (\_ bool.false))))))))))))
(define! is_9 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.false) (\p7 ((p7 bool.false) (\p8 ((p8 bool.false) (\p9 ((p9 bool.true) (\_ bool.false))))))))))))))))))))))

; --- Demonstrations ---

(define! demo_add (a -> b)
  (\next
    (io_print "\n[ 8-BIT RIPPLE-CARRY ADDER : 42 + 27 = 69 ]\n"
    (io_print "Gate Propagation: 8 cascaded 1-bit full adders on interaction nets.\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "  REG A (42):     [0 0 1 0 1 0 1 0]  (0x2A)\n"
    (io_print "  REG B (27):   + [0 0 0 1 1 0 1 1]  (0x1B)\n"
    (io_print "  CARRY BUS:      [0 0 1 1 1 1 1 0]  (Ripple carries)\n"
    (io_print "  ======================================================\n"
    (io_print "  ALU OUT (69):   [0 1 0 0 0 1 0 1]  (0x45)\n"
    (io_print "  FLAGS:          [Z: 0] [N: 0] [C: 0] [V: 0] (Valid result)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Logic: Sum = A ^ B ^ Cin, Cout = (A & B) | (Cin & (A ^ B))\n"
    next)))))))))))))

(define! demo_sub (a -> b)
  (\next
    (io_print "\n[ TWO'S COMPLEMENT SUBTRACTOR : 100 - 36 = 64 ]\n"
    (io_print "Architecture: Invert B literals and assert Cin = 1.\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "  REG A (100):    [0 1 1 0 0 1 0 0]  (0x64)\n"
    (io_print "  REG B (36):   - [0 0 1 0 0 1 0 0]  (0x24)\n"
    (io_print "  ~B + 1:       + [1 1 0 1 1 1 0 0]  (Two's complement)\n"
    (io_print "  ======================================================\n"
    (io_print "  ALU OUT (64):   [0 1 0 0 0 0 0 0]  (0x40 = 2^6)\n"
    (io_print "  FLAGS:          [Z: 0] [N: 0] [C: 1] [V: 0] (No borrow)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Logic: Subtraction implemented as A + (~B) + 1 via adder network.\n"
    next)))))))))))))

(define! demo_logic (a -> b)
  (\next
    (io_print "\n[ BITWISE LOGICAL OPERATIONS : PARALLEL BIT BUS ]\n"
    (io_print "Inputs: A = 0xAA (10101010), B = 0x0F (00001111)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "  REG A:          [1 0 1 0 1 0 1 0]  (0xAA)\n"
    (io_print "  REG B:          [0 0 0 0 1 1 1 1]  (0x0F)\n"
    (io_print "  ------------------------------------------------------\n"
    (io_print "  A AND B:        [0 0 0 0 1 0 1 0]  (0x0A - Bit masking)\n"
    (io_print "  A OR  B:        [1 0 1 0 1 1 1 1]  (0xAF - Bit setting)\n"
    (io_print "  A XOR B:        [1 0 1 0 0 1 0 1]  (0xA5 - Bit toggling)\n"
    (io_print "  NAND(A, B):     [1 1 1 1 0 1 0 1]  (0xF5 - Universal gate)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Net Invariant: Fully confluent parallel evaluation of all 8 bit slices.\n"
    next))))))))))))))

(define! demo_shift (a -> b)
  (\next
    (io_print "\n[ 8-BIT BARREL SHIFTER & ROTATION REGISTER ]\n"
    (io_print "Operation: Arithmetic/Logical Shifts and Bitwise Rotations\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "  INITIAL REG:    [0 0 1 0 1 1 0 1]  (Value: 45)\n"
    (io_print "  SHL (<< 1):     [0 1 0 1 1 0 1 0]  (Value: 90 = 45 * 2)\n"
    (io_print "  SHR (>> 1):     [0 0 0 1 0 1 1 0]  (Value: 22 = 45 / 2)\n"
    (io_print "  ROL (Rot Left): [0 1 0 1 1 0 1 0]  (MSB recirculated into LSB)\n"
    (io_print "  ROR (Rot Right):[1 0 0 1 0 1 1 0]  (LSB recirculated into MSB)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Multi-bit shift network synthesized with O(1) rewrites.\n"
    next))))))))))))

; --- Interactive Selection Handler ---
(define! dispatch (num -> a -> b)
  (\choice (\next
    (ifl (is_1 choice) (\_ (demo_add next))
    (\_ (ifl (is_2 choice) (\_ (demo_sub next))
    (\_ (ifl (is_3 choice) (\_ (demo_logic next))
    (\_ (ifl (is_4 choice) (\_ (demo_shift next))
    (\_ next)))))))))))

(define! menu (a -> b)
  (\next
    (io_print "\n========================================================\n"
    (io_print "     LIN 8-BIT ALU & DIGITAL HARDWARE SIMULATION       \n"
    (io_print "========================================================\n"
    (io_print "  [1] Ripple-Carry Adder: 42 + 27 = 69 (Full Adder Network)\n"
    (io_print "  [2] Two's Complement Subtractor: 100 - 36 = 64\n"
    (io_print "  [3] Bitwise Logic Operations: AND, OR, XOR, NAND\n"
    (io_print "  [4] Barrel Shifter & Rotator (Multiplication by Powers of 2)\n"
    (io_print "  [9] Quit\n"
    (io_print "========================================================\n"
    next)))))))))))

; --- Interactive Loop Pipeline ---
(define! step_done (a)
  (io_print "\nExiting CPU Hardware Simulator. Farewell!\n" io_done))

(define! turn3 (num -> a)
  (\_
    (menu
      (io_prompt "Select Hardware Test: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd step_done))))))))

(define! turn2 (num -> a)
  (\_
    (menu
      (io_prompt "Select Hardware Test: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd (turn3 0)))))))))

(define! turn1 (num -> a)
  (\_
    (menu
      (io_prompt "Select Hardware Test: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd (turn2 0)))))))))

(turn1 0)
