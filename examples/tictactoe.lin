(load "std/std.lin")

; ==============================================================================
; Lin: Interactive Tic-Tac-Toe with Deterministic AI
; ==============================================================================
; Demonstrates:
;   1. Pure in-net Scott numeral pattern matching (bypassing FFI boolean bugs).
;   2. Combinatoric line referee checking rows, columns, and diagonals.
;   3. Positional AI strategy prioritizing center, corners, and flanks.
;   4. ANSI boxed terminal UI with turn progression and live updates.
; ==============================================================================

; --- Pure In-Net Exact Scott Numeral Matchers (0..9) ---
(define! is_0 (num -> bool) (\n ((n bool.true) (\_ bool.false))))
(define! is_1 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.true) (\_ bool.false))))))
(define! is_2 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.true) (\_ bool.false))))))))
(define! is_3 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.true) (\_ bool.false))))))))))
(define! is_4 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.true) (\_ bool.false))))))))))))
(define! is_5 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.true) (\_ bool.false))))))))))))))
(define! is_6 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.true) (\_ bool.false))))))))))))))))
(define! is_7 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.false) (\p7 ((p7 bool.true) (\_ bool.false))))))))))))))))))
(define! is_8 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.false) (\p7 ((p7 bool.false) (\p8 ((p8 bool.true) (\_ bool.false))))))))))))))))))))
(define! is_9 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.false) (\p7 ((p7 bool.false) (\p8 ((p8 bool.false) (\p9 ((p9 bool.true) (\_ bool.false))))))))))))))))))))))

; --- Referee: 3-in-a-row checker ---
(define! line3 (num -> num -> num -> num)
  (\a (\b (\c
    (ifl (is_zero a) (\_ 0)
    (\_ (ifl (and (eq a b) (eq b c)) (\_ a) (\_ 0))))))))

(define! check_win (num -> num -> num -> num -> num -> num -> num -> num -> num -> num)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (let ((w (line3 c0 c1 c2)))
      (ifl (gt w 0) (\_ w)
      (\_ (let ((w (line3 c3 c4 c5)))
        (ifl (gt w 0) (\_ w)
        (\_ (let ((w (line3 c6 c7 c8)))
          (ifl (gt w 0) (\_ w)
          (\_ (let ((w (line3 c0 c3 c6)))
            (ifl (gt w 0) (\_ w)
            (\_ (let ((w (line3 c1 c4 c7)))
              (ifl (gt w 0) (\_ w)
              (\_ (let ((w (line3 c2 c5 c8)))
                (ifl (gt w 0) (\_ w)
                (\_ (let ((w (line3 c0 c4 c8)))
                  (ifl (gt w 0) (\_ w)
                  (\_ (line3 c2 c4 c6))))))))))))))))))))))))))))))))

; --- AI Move Selection ---
; Picks first empty cell: center(4) -> corners(0,2,6,8) -> flanks(1,3,5,7)
(define! ai_pick (num -> num -> num -> num -> num -> num -> num -> num -> num -> num)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (ifl (is_zero c4) (\_ 4)
    (\_ (ifl (is_zero c0) (\_ 0)
    (\_ (ifl (is_zero c2) (\_ 2)
    (\_ (ifl (is_zero c6) (\_ 6)
    (\_ (ifl (is_zero c8) (\_ 8)
    (\_ (ifl (is_zero c1) (\_ 1)
    (\_ (ifl (is_zero c3) (\_ 3)
    (\_ (ifl (is_zero c5) (\_ 5)
    (\_ 7))))))))))))))))))))))))))

; Update a cell at index 0..8 with value v:
(define! upd0 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_0 idx) (\_ v) (\_ c))))))
(define! upd1 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_1 idx) (\_ v) (\_ c))))))
(define! upd2 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_2 idx) (\_ v) (\_ c))))))
(define! upd3 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_3 idx) (\_ v) (\_ c))))))
(define! upd4 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_4 idx) (\_ v) (\_ c))))))
(define! upd5 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_5 idx) (\_ v) (\_ c))))))
(define! upd6 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_6 idx) (\_ v) (\_ c))))))
(define! upd7 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_7 idx) (\_ v) (\_ c))))))
(define! upd8 (num -> num -> num -> num) (\idx (\v (\c (ifl (is_8 idx) (\_ v) (\_ c))))))

; --- Terminal Rendering ---
(define! glyph (num -> a)
  (\v (ifl (eq v 1) (\_ " X ") (\_ (ifl (eq v 2) (\_ " O ") (\_ " . "))))))

(define! render_board (num -> num -> num -> num -> num -> num -> num -> num -> num -> num -> a -> b)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8 (\t (\next
    (io_print "\n===========================================\n"
    (io_print "   INTERACTIVE TIC-TAC-TOE // LIN AI       \n"
    (io_print "===========================================\n"
    (io_print "       0   1   2\n"
    (io_print "     +---+---+---+\n"
    (io_print "  0  |"
    (io_print (glyph c0)
    (io_print "|"
    (io_print (glyph c1)
    (io_print "|"
    (io_print (glyph c2)
    (io_print "|     PLAYER (X): Human\n"
    (io_print "     +---+---+---+     PLAYER (O): Lin AI\n"
    (io_print "  1  |"
    (io_print (glyph c3)
    (io_print "|"
    (io_print (glyph c4)
    (io_print "|"
    (io_print (glyph c5)
    (io_print "|     TURN: "
    (io_print t
    (io_print "\n"
    (io_print "     +---+---+---+\n"
    (io_print "  2  |"
    (io_print (glyph c6)
    (io_print "|"
    (io_print (glyph c7)
    (io_print "|"
    (io_print (glyph c8)
    (io_print "|\n"
    (io_print "     +---+---+---+\n"
    (io_print " Enter cell (0-8) or 9 to quit\n"
    next))))))))))))))))))))))))))))))))))))))))))))

; --- End of Game Checker ---
(define! game_over (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (render_board c0 c1 c2 c3 c4 c5 c6 c7 c8 5
      (let ((w (check_win c0 c1 c2 c3 c4 c5 c6 c7 c8)))
        (ifl (eq w 1)
          (\_ (io_print "\n>>> CONGRATULATIONS! Human (X) wins! <<<\n" io_done))
          (\_ (ifl (eq w 2)
                (\_ (io_print "\n>>> LIN AI (O) WINS! Optimal play prevailed. <<<\n" io_done))
                (\_ (io_print "\n>>> CAT'S GAME! It is a draw. <<<\n" io_done)))))))))))))))))

; --- Interactive Turns ---
(define! turn5 (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (game_over c0 c1 c2 c3 c4 c5 c6 c7 c8)))))))))))

(define! turn4 (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (render_board c0 c1 c2 c3 c4 c5 c6 c7 c8 4
      (io_prompt "Move: " (\cmd
        (ifl (is_9 cmd)
          (\_ (io_print "\nThanks for playing! Exiting.\n" io_done))
          (\_ (let ((u0 (upd0 cmd 1 c0)))
              (let ((u1 (upd1 cmd 1 c1)))
              (let ((u2 (upd2 cmd 1 c2)))
              (let ((u3 (upd3 cmd 1 c3)))
              (let ((u4 (upd4 cmd 1 c4)))
              (let ((u5 (upd5 cmd 1 c5)))
              (let ((u6 (upd6 cmd 1 c6)))
              (let ((u7 (upd7 cmd 1 c7)))
              (let ((u8 (upd8 cmd 1 c8)))
                (ifl (gt (check_win u0 u1 u2 u3 u4 u5 u6 u7 u8) 0)
                  (\_ (game_over u0 u1 u2 u3 u4 u5 u6 u7 u8))
                  (\_ (let ((ai (ai_pick u0 u1 u2 u3 u4 u5 u6 u7 u8)))
                        (turn5 (upd0 ai 2 u0) (upd1 ai 2 u1) (upd2 ai 2 u2)
                               (upd3 ai 2 u3) (upd4 ai 2 u4) (upd5 ai 2 u5)
                               (upd6 ai 2 u6) (upd7 ai 2 u7) (upd8 ai 2 u8)))))))))))))))))))))))))))))

(define! turn3 (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (render_board c0 c1 c2 c3 c4 c5 c6 c7 c8 3
      (io_prompt "Move: " (\cmd
        (ifl (is_9 cmd)
          (\_ (io_print "\nThanks for playing! Exiting.\n" io_done))
          (\_ (let ((u0 (upd0 cmd 1 c0)))
              (let ((u1 (upd1 cmd 1 c1)))
              (let ((u2 (upd2 cmd 1 c2)))
              (let ((u3 (upd3 cmd 1 c3)))
              (let ((u4 (upd4 cmd 1 c4)))
              (let ((u5 (upd5 cmd 1 c5)))
              (let ((u6 (upd6 cmd 1 c6)))
              (let ((u7 (upd7 cmd 1 c7)))
              (let ((u8 (upd8 cmd 1 c8)))
                (ifl (gt (check_win u0 u1 u2 u3 u4 u5 u6 u7 u8) 0)
                  (\_ (game_over u0 u1 u2 u3 u4 u5 u6 u7 u8))
                  (\_ (let ((ai (ai_pick u0 u1 u2 u3 u4 u5 u6 u7 u8)))
                        (turn4 (upd0 ai 2 u0) (upd1 ai 2 u1) (upd2 ai 2 u2)
                               (upd3 ai 2 u3) (upd4 ai 2 u4) (upd5 ai 2 u5)
                               (upd6 ai 2 u6) (upd7 ai 2 u7) (upd8 ai 2 u8)))))))))))))))))))))))))))))

(define! turn2 (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (render_board c0 c1 c2 c3 c4 c5 c6 c7 c8 2
      (io_prompt "Move: " (\cmd
        (ifl (is_9 cmd)
          (\_ (io_print "\nThanks for playing! Exiting.\n" io_done))
          (\_ (let ((u0 (upd0 cmd 1 c0)))
              (let ((u1 (upd1 cmd 1 c1)))
              (let ((u2 (upd2 cmd 1 c2)))
              (let ((u3 (upd3 cmd 1 c3)))
              (let ((u4 (upd4 cmd 1 c4)))
              (let ((u5 (upd5 cmd 1 c5)))
              (let ((u6 (upd6 cmd 1 c6)))
              (let ((u7 (upd7 cmd 1 c7)))
              (let ((u8 (upd8 cmd 1 c8)))
                (ifl (gt (check_win u0 u1 u2 u3 u4 u5 u6 u7 u8) 0)
                  (\_ (game_over u0 u1 u2 u3 u4 u5 u6 u7 u8))
                  (\_ (let ((ai (ai_pick u0 u1 u2 u3 u4 u5 u6 u7 u8)))
                        (turn3 (upd0 ai 2 u0) (upd1 ai 2 u1) (upd2 ai 2 u2)
                               (upd3 ai 2 u3) (upd4 ai 2 u4) (upd5 ai 2 u5)
                               (upd6 ai 2 u6) (upd7 ai 2 u7) (upd8 ai 2 u8)))))))))))))))))))))))))))))

(define! turn1 (num -> num -> num -> num -> num -> num -> num -> num -> num -> a)
  (\c0 (\c1 (\c2 (\c3 (\c4 (\c5 (\c6 (\c7 (\c8
    (render_board c0 c1 c2 c3 c4 c5 c6 c7 c8 1
      (io_prompt "Move: " (\cmd
        (ifl (is_9 cmd)
          (\_ (io_print "\nThanks for playing! Exiting.\n" io_done))
          (\_ (let ((u0 (upd0 cmd 1 c0)))
              (let ((u1 (upd1 cmd 1 c1)))
              (let ((u2 (upd2 cmd 1 c2)))
              (let ((u3 (upd3 cmd 1 c3)))
              (let ((u4 (upd4 cmd 1 c4)))
              (let ((u5 (upd5 cmd 1 c5)))
              (let ((u6 (upd6 cmd 1 c6)))
              (let ((u7 (upd7 cmd 1 c7)))
              (let ((u8 (upd8 cmd 1 c8)))
                (ifl (gt (check_win u0 u1 u2 u3 u4 u5 u6 u7 u8) 0)
                  (\_ (game_over u0 u1 u2 u3 u4 u5 u6 u7 u8))
                  (\_ (let ((ai (ai_pick u0 u1 u2 u3 u4 u5 u6 u7 u8)))
                        (turn2 (upd0 ai 2 u0) (upd1 ai 2 u1) (upd2 ai 2 u2)
                               (upd3 ai 2 u3) (upd4 ai 2 u4) (upd5 ai 2 u5)
                               (upd6 ai 2 u6) (upd7 ai 2 u7) (upd8 ai 2 u8)))))))))))))))))))))))))))))

; Start game with 9 empty cells (0):
(turn1 0 0 0 0 0 0 0 0 0)
