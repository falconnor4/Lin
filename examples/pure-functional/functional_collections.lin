; ==============================================================================
; functional_collections.lin  —  immutable collections via pure functions
; ------------------------------------------------------------------------------
; Property:  Lin's standard collections are *purely functional*: a "push" or
; "insert" returns a NEW structure and leaves the old one intact, sharing the
; unchanged tail / untouched subtree through the interaction net's DUP rewrite.
;
;   - queue:  amortized-O(1) banker's FIFO queue built from two shared lists.
;   - stream: infinite lazy streams generated corecursively (never materialized).
;   - set:    functional BST set; membership by comparison.
;   - map:    functional BST dictionary keyed by comparison.
;
; Every top-level line reduces to one normal form and prints one `=> <value>`.
;
;   Running:  cd /home/falconnor4/github/Lin && ./lin examples/pure-functional/functional_collections.lin
; ==============================================================================
(load "std/std.lin")

; --- Queue: FIFO order is preserved, and the original queue is unchanged -----
(define q0 empty_queue)
(is_empty_queue q0)
; expect => true

; push 10, then 20, then 30 -> head of the FIFO is 10.
(define q1 (queue_push 10 q0))
(is_empty_queue q1)
; expect => false
(queue_peek q1)
; expect => 10

(define q2 (queue_push 20 q1))
(define q3 (queue_push 30 q2))
(queue_peek q3)
; expect => 10

; pop consumes from the front: 10 -> 20 -> 30, then the queue is empty.
(queue_peek (queue_pop q3))
; expect => 20
(queue_peek (queue_pop (queue_pop q3)))
; expect => 30
(is_empty_queue (queue_pop (queue_pop (queue_pop q3))))
; expect => true

; Peeking does not consume: q3 still holds 10 at the front (immutability).
(queue_peek q3)
; expect => 10
(is_empty_queue q3)
; expect => false

; --- Streams: infinite sequences pulled lazily, one element at a time --------
(stream_head (nats_from 0))
; expect => 0
(stream_head (stream_tail (nats_from 0)))
; expect => 1
(stream_nth0 (nats_from 7))
; expect => 7
(stream_nth1 (nats_from 7))
; expect => 8
(stream_nth2 (nats_from 7))
; expect => 9

; Church-numeral iteration pulls an arbitrary element / drops k positions.
(define c4 (\f (\x (f (f (f (f x)))))))
(define c2 (\f (\x (f (f x)))))
(stream_nth_c c4 (nats_from 0))
; expect => 4
(stream_head (stream_drop_c c2 (nats_from 10)))
; expect => 12

; `repeat` is a constant stream; stream_takeN realizes a finite *shared* prefix.
(first (stream_take4 (repeat 9)))
; expect => 9
(fourth (stream_take4 (repeat 9)))
; expect => 9
(first (stream_take2 (nats_from 100)))
; expect => 100
(second (stream_take2 (nats_from 100)))
; expect => 101

; --- Set: functional BST, membership by comparison ---------------------------
(define s0 empty_set)
(is_empty_set s0)
; expect => true
(define s1 (set_insert 3 (set_insert 1 empty_set)))
(set_member 1 s1)
; expect => true
(set_member 3 s1)
; expect => true
(set_member 2 s1)
; expect => false
; Idempotent insert — set_insert 1 s1 returns a NEW set but s1 is untouched.
(define s2 (set_insert 5 s1))
(set_member 5 s2)
; expect => true
(set_member 1 s1)
; expect => true
(set_member 5 s1)
; expect => false

; --- Map: functional BST dictionary ------------------------------------------
(define m0 empty_map)
(is_empty_map m0)
; expect => true
(define m1 (map_insert 2 20 (map_insert 1 10 empty_map)))
(map_has 1 m1)
; expect => true
(map_get_or 0 2 m1)
; expect => 20
(map_get_or 0 5 m1)
; expect => 0
; Immutability: m1 retains only {1:10, 2:20} after "inserting" 5 into m2.
(define m2 (map_insert 5 50 m1))
(map_get_or 0 5 m2)
; expect => 50
(map_get_or 0 5 m1)
; expect => 0
(map_get_or 0 2 m1)
; expect => 20