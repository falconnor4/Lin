; ==============================================================================
; tiny_kernel.lin  —  a pure numeric reduction (sum of squares)
; ------------------------------------------------------------------------------
; Property:  Lin performs optimization *by construction* — interaction nets with
; Levy-optimal beta sharing.  A fold-like reduction over a fixed range shares the
; arithmetic work through the graph rather than recalculating, and the whole
; reduction is a single pure expression: no mutation, no loop, one normal form.
;
; We reduce the first n natural numbers via a self-tail-recursive accumulator
; (sum of squares = n(n+1)(2n+1)/6; for n = 5 that is 30).
;
;   Running:  cd /home/falconnor4/github/Lin && ./lin examples/numeric-float/tiny_kernel.lin
; ==============================================================================
(load "std/std.lin")

; --- Sum of squares of 0..n, accumulator style --------------------------------
; ssq acc n = acc + n^2 + ssq(acc + n^2, n - 1), base case n = 0 -> acc.
(define ssq (\acc (\n (ifl (is_zero n) (\_ acc)
                            (\_ (ssq (add acc (mul n n)) (pred n)))))))
(ssq 0 5)                        ; 0^2+1^2+2^2+3^2+4^2+5^2 = 55
; expect => 55
(ssq 0 1)                        ; 0^2+1^2 = 1
; expect => 1

; --- Short geometric series 1 + 2 + 4 + ... + 2^k -----------------------------
; Series up to 2^4 = 31.
(define series (\acc (\k (ifl (is_zero k) (\_ (add acc 1))
                                (\_ (series (add acc (pow 2 k)) (pred k)))))))
(series 0 4)
; expect => 31

; --- Composite reduction: sum-of-squares then square it -----------------------
; (1^2 + 2^2)^2 = (5)^2 = 25.
(mul (ssq 0 2) (ssq 0 2))
; expect => 25