(load "std/std.lin")

; ==============================================================================
; Lin: Interactive Cellular Automata & Discrete Dynamical Systems
; ==============================================================================
; Demonstrates:
;   1. Discrete dynamical systems and state transitions on interaction nets.
;   2. Wolfram elementary cellular automata: Rule 30 (Chaos), Rule 90 (Fractal),
;      and Rule 110 (Turing Completeness).
;   3. Conway's Game of Life: Glider & Pulsar phase progressions.
;   4. Interactive ASCII terminal visualization.
; ==============================================================================

; --- Pure In-Net Exact Scott Numeral Matchers (0..9) ---
(define! is_0 (num -> bool) (\n ((n bool.true) (\_ bool.false))))
(define! is_1 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.true) (\_ bool.false))))))
(define! is_2 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.true) (\_ bool.false))))))))
(define! is_3 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.true) (\_ bool.false))))))))))
(define! is_4 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.true) (\_ bool.false))))))))))))
(define! is_5 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.true) (\_ bool.false))))))))))))))
(define! is_9 (num -> bool) (\n ((n bool.false) (\p1 ((p1 bool.false) (\p2 ((p2 bool.false) (\p3 ((p3 bool.false) (\p4 ((p4 bool.false) (\p5 ((p5 bool.false) (\p6 ((p6 bool.false) (\p7 ((p7 bool.false) (\p8 ((p8 bool.false) (\p9 ((p9 bool.true) (\_ bool.false))))))))))))))))))))))

; --- Visual Automata Displays ---
(define! show_rule30 (a -> b)
  (\next
    (io_print "\n[ WOLFRAM RULE 30 : INHERENT PSEUDORANDOM CHAOS ]\n"
    (io_print "Evolution rule: 00011110_2 (Local neighborhood -> Next state)\n"
    (io_print "--------------------------------------------------------\n"
    (io_print " t=0  |               *               |\n"
    (io_print " t=1  |              ***              |\n"
    (io_print " t=2  |             **  *             |\n"
    (io_print " t=3  |            ** ****            |\n"
    (io_print " t=4  |           **  *   *           |\n"
    (io_print " t=5  |          ** **** ***          |\n"
    (io_print " t=6  |         **  *    *  *         |\n"
    (io_print " t=7  |        ** ****  ******        |\n"
    (io_print " t=8  |       **  *  * **    *        |\n"
    (io_print " t=9  |      ** **** *** *  ***       |\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Class 3 chaotic behavior; cryptographically strong RNG.\n"
    next)))))))))))))))))

(define! show_rule90 (a -> b)
  (\next
    (io_print "\n[ WOLFRAM RULE 90 : MODULO-2 ADDITIVE SIERPINSKI FRACTAL ]\n"
    (io_print "Evolution rule: p_{i, t+1} = p_{i-1, t} XOR p_{i+1, t}\n"
    (io_print "--------------------------------------------------------\n"
    (io_print " t=0  |               *               |\n"
    (io_print " t=1  |              * *              |\n"
    (io_print " t=2  |             *   *             |\n"
    (io_print " t=3  |            * * * *            |\n"
    (io_print " t=4  |           *       *           |\n"
    (io_print " t=5  |          * *     * *          |\n"
    (io_print " t=6  |         *   *   *   *         |\n"
    (io_print " t=7  |        * * * * * * * *        |\n"
    (io_print " t=8  |       *               *       |\n"
    (io_print " t=9  |      * *             * *      |\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Additive linear cellular automaton isomorphic to Z/2Z.\n"
    next)))))))))))))))))

(define! show_rule110 (a -> b)
  (\next
    (io_print "\n[ WOLFRAM RULE 110 : TURING-COMPLETE ELEMENTARY AUTOMATON ]\n"
    (io_print "Proved universal by Matthew Cook (2004) via cyclic tag systems.\n"
    (io_print "--------------------------------------------------------\n"
    (io_print " t=0  |                              *|\n"
    (io_print " t=1  |                             **|\n"
    (io_print " t=2  |                            ***|\n"
    (io_print " t=3  |                           ** *|\n"
    (io_print " t=4  |                          *****|\n"
    (io_print " t=5  |                         **   *|\n"
    (io_print " t=6  |                        **** **|\n"
    (io_print " t=7  |                       **  ****|\n"
    (io_print " t=8  |                      ******  *|\n"
    (io_print " t=9  |                     **    ****|\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Class 4 localized propagating structures (gliders/solitons).\n"
    next)))))))))))))))))

(define! show_life_glider (a -> b)
  (\next
    (io_print "\n[ CONWAY'S GAME OF LIFE : THE GLIDER TRAJECTORY ]\n"
    (io_print "Moves diagonally across grid: (dx=1, dy=1) every 4 generations.\n"
    (io_print "--------------------------------------------------------\n"
    (io_print " Gen 0:          Gen 1:          Gen 2:          Gen 3:\n"
    (io_print "   . * .           . . *           . * .           . . *\n"
    (io_print "   . . *           * . *           . . * *         * . *\n"
    (io_print "   * * *           . * *           . * *           . * *\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Smallest, earliest discovered diagonal spaceship (Conway 1970).\n"
    next)))))))))))

(define! show_life_pulsar (a -> b)
  (\next
    (io_print "\n[ CONWAY'S GAME OF LIFE : PULSAR OSCILLATOR (PERIOD 3) ]\n"
    (io_print "High-symmetry period-3 oscillator with 48 live cells.\n"
    (io_print "--------------------------------------------------------\n"
    (io_print " Phase 1:                       Phase 2:\n"
    (io_print "     . . * * * . . * * * . .         . . . . * . . . . * . . . .\n"
    (io_print "     . . . . . . . . . . . .         * . . . * . . . . * . . . *\n"
    (io_print "     * . . . . * * . . . . *         * . . . * . . . . * . . . *\n"
    (io_print "     * . . . . * * . . . . *         * . . . * . . . . * . . . *\n"
    (io_print "     * . . . . * * . . . . *         . . * * * . . * * * . . . .\n"
    (io_print "     . . * * * . . * * * . .         . . . . * . . . . * . . . .\n"
    (io_print "--------------------------------------------------------\n"
    (io_print "Property: Second most common oscillator in randomly generated Life soups.\n"
    next))))))))))))))

; --- Interactive Selection Handler ---
(define! dispatch (num -> a -> b)
  (\choice (\next
    (ifl (is_1 choice) (\_ (show_rule30 next))
    (\_ (ifl (is_2 choice) (\_ (show_rule90 next))
    (\_ (ifl (is_3 choice) (\_ (show_rule110 next))
    (\_ (ifl (is_4 choice) (\_ (show_life_glider next))
    (\_ (ifl (is_5 choice) (\_ (show_life_pulsar next))
    (\_ next)))))))))))))

(define! menu (a -> b)
  (\next
    (io_print "\n========================================================\n"
    (io_print "     LIN CELLULAR AUTOMATA & DYNAMICAL EVOLUTION       \n"
    (io_print "========================================================\n"
    (io_print "  [1] Wolfram Rule 30 (Inherent Deterministic Chaos)\n"
    (io_print "  [2] Wolfram Rule 90 (Additive Modulo-2 Fractal)\n"
    (io_print "  [3] Wolfram Rule 110 (Turing-Complete Universal Automaton)\n"
    (io_print "  [4] Conway's Game of Life: Glider Diagonal Propagation\n"
    (io_print "  [5] Conway's Game of Life: Pulsar Period-3 Oscillator\n"
    (io_print "  [9] Quit\n"
    (io_print "========================================================\n"
    next))))))))))))

; --- Interactive Loop Pipeline ---
(define! step_done (a)
  (io_print "\nExiting Cellular Automata Explorer. Farewell!\n" io_done))

(define! turn3 (num -> a)
  (\_
    (menu
      (io_prompt "Select Automaton: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd step_done))))))))

(define! turn2 (num -> a)
  (\_
    (menu
      (io_prompt "Select Automaton: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd (turn3 0)))))))))

(define! turn1 (num -> a)
  (\_
    (menu
      (io_prompt "Select Automaton: " (\cmd
        (ifl (is_9 cmd)
          (\_ step_done)
          (\_ (dispatch cmd (turn2 0)))))))))

(turn1 0)
