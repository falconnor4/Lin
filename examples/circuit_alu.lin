; ==============================================================================
; Digital Circuit & 4-Bit Arithmetic Logic Unit (ALU) Simulation in Lin
;
; Demonstrates how interaction nets naturally simulate physical hardware
; netlists, wire propagation, and digital logic circuits without emulation
; overhead. Every gate is an interaction net node; wires are net connections.
; ==============================================================================

(load "std/bool.lin")
(load "std/pair.lin")

; ------------------------------------------------------------------------------
; 1. Primitive Logic Gates
; ------------------------------------------------------------------------------
; Half adder: computes (pair sum carry)
(define half_adder
  (\a (\b
    (pair (xor a b) (and a b)))))

; Full adder: computes (pair sum cout)
(define fa_sum  (\a (\b (\cin (xor (xor a b) cin)))))
(define fa_cout (\a (\b (\cin (or (and a b) (and (xor a b) cin))))))
(define full_adder
  (\a (\b (\cin
    (pair (fa_sum a b cin) (fa_cout a b cin))))))

; ------------------------------------------------------------------------------
; 2. 1-Bit ALU Slice
; Supports 4 operations via control lines (op0, op1):
;   op0=0, op1=0 => ADD (with carry-in)
;   op0=1, op1=0 => AND
;   op0=0, op1=1 => OR
;   op0=1, op1=1 => XOR
; ------------------------------------------------------------------------------
(define alu1
  (\op0 (\op1 (\a (\b (\cin
    (if op1
      (if op0 (xor a b) (or a b))
      (if op0 (and a b) (fa_sum a b cin)))))))))

; ------------------------------------------------------------------------------
; 3. 4-Bit Ripple-Carry Addition
; Computes A + B for two 4-bit nibbles:
;   A = 5 (0101_2: a0=T, a1=F, a2=T, a3=F)
;   B = 3 (0011_2: b0=T, b1=T, b2=F, b3=F)
; Expected Sum = 8 (1000_2: s0=F, s1=F, s2=F, s3=T, cout=F)
; ------------------------------------------------------------------------------
(define cin0 false)

(define s0 (fa_sum true true cin0))
(define c0 (fa_cout true true cin0))

(define s1 (fa_sum false true c0))
(define c1 (fa_cout false true c0))

(define s2 (fa_sum true false c1))
(define c2 (fa_cout true false c1))

(define s3 (fa_sum false false c2))
(define c3 (fa_cout false false c2))

; Bit 0 of sum (least significant):
s0

; Bit 1 of sum:
s1

; Bit 2 of sum:
s2

; Bit 3 of sum:
s3

; Carry-out (overflow):
c3

; ------------------------------------------------------------------------------
; 4. Testing ALU Operations on 1-Bit Inputs (A=1, B=0, Cin=1)
; ------------------------------------------------------------------------------
; ALU Op 00: ADD (1 + 0 + 1 = 0)
(alu1 false false true false true)

; ALU Op 10: AND (1 and 0 = 0)
(alu1 true false true false false)

; ALU Op 01: OR (1 or 0 = 1)
(alu1 false true true false false)

; ALU Op 11: XOR (1 xor 1 = 0)
(alu1 true true true true false)
