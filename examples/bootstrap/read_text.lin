; ==============================================================================
; Bootstrapped Lin compiler -- reader, stage 1: tokens  (TEXT-DOMAIN VARIANT)
;
; NOT YET THE READER: this file tokenizes through the text domain (std/text.lin) and is correct at
; the top level, but its recursion does not work YET -- an `_ffi` call whose result feeds a
; CONDITION inside a RECURSIVE definition still answers garbage (measured: `(tbend s i)` in a
; recursive def printed 108 where 7 was expected, while the same call in a non-recursive def is
; right).  read.lin is the working reader; this is the shape it should become once that fold works.
; ==============================================================================
; Turns Lin source (a string) into a list of tokens, each token keeping its own text, so a symbol
; keeps its spelling and a number keeps its digits.  The parser above this turns the token list
; into the term AST.
;
; TEXT, NOT CONS CELLS.  The source is indexed through the text domain (std/text.lin,
; std/drivers/text.c): walking a Lin string one cons cell at a time costs the net a reduction per
; character (measured: 0.28 s per character on the cons-walking reader this replaces).  Every test
; here is a BOOLEAN row (tbhas, tbend), so the loop head branches without a numeric comparison --
; a comparison inside a recursive definition is the shape that costs thousands of firings.
;
; The index convention the text rows share: an index past the end IS the end (tfind/tfindany clamp
; to the length), so no branch has to test for -1.
;
; OBSERVING THE RESULT: this engine prints a LIST OF STRINGS as an _ffi call shape
; (ffi: symbol 'ab' not found), so a token list is inspected by counting (ntokens) and comparing
; (streq), never by printing it.
; ==============================================================================

(load "std/std.lin")
(load "std/text.lin")

(namespace boot_read)
(open text)

; skip whitespace, then read one token: a paren, a quoted literal (quotes kept), a comment to end
; of line, or a run of text up to the next delimiter
(define! lex (list num -> num -> list (list num) -> list (list num)) (\s (\i (\acc (let ((j (trun s i " \n\t\r"))) (ifl (tbend s j) (\_ acc) (\_ (ifl (tbhas s j "(") (\_ (lex s (add j 1) (list.cons "(" acc))) (\_ (ifl (tbhas s j ")") (\_ (lex s (add j 1) (list.cons ")" acc))) (\_ (ifl (tbhas s j ";") (\_ (lex s (add (tfind s j 10) 1) acc)) (\_ (ifl (tbhas s j "\"") (\_ (let ((e (add (tfind s (add j 1) 34) 1))) (lex s e (list.cons (tsub s j (sub e j)) acc)))) (\_ (let ((e (tfindany s j " \n\t\r;()\""))) (lex s e (list.cons (tsub s j (sub e j)) acc))))))))))))))))))

(define! tokenize (list num -> list (list num)) (\s (lex s 0 list.nil)))

(define! ntokens (list (list num) -> num) (\l (if (list.is_empty l) 0 (num.succ (ntokens (list.tail l))))))

(namespace _)
(export boot_read)
