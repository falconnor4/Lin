; ==============================================================================
; Bootstrapped Lin compiler -- entry point
; ==============================================================================
; Stage 1 of the self-host.  The source text arrives in LIN_BOOT_SRC (the
; language has no argv accessor yet) and io_file hands it over AS A SCOTT LIST
; OF CHAR CODES, so the whole front end runs in pure Lin.
;
; Today this READS its first datum and prints it.  The reader (lexer, parenthesis
; tree, parser) and the Term printer are done, so `(\x x)` already matches the C
; engine exactly; compiling the Term into an interaction net and reducing it is
; the next stage.
; ==============================================================================

(load "std/std.lin")
(load "examples/bootstrap/front.lin")
(load "examples/bootstrap/types.lin")

(io_file ".boot-src"
  (\src (io_print "=> " (io_print (boot_types.tstr (list.head (boot_front.read_forms src))) (io_print "\n" 0))))))
