; ==============================================================================
; SAT Solving & Certificate Verification in Lin
;
; Demonstrates:
;   1. Boolean 3-SAT formula formulation.
;   2. Candidate model extraction via self-reducible witness probing (probe3).
;   3. Linear-time independent certificate verification (verify3).
; ==============================================================================

(load "std/sat.lin")

; A 3-variable formula:
;   (x1 or x2 or x3) and
;   (not x1 or x2 or not x3) and
;   (not x1 or not x2 or x3)
(define f
  (\x1 (\x2 (\x3
    (and3 (clause3 x1 x2 x3)
          (clause3 (not x1) x2 (not x3))
          (clause3 (not x1) (not x2) x3))))))

; Probe for a candidate satisfying assignment:
(define result (probe3 f))

; Satisfiable:
(fst result)

; Extract the candidate model (witness tuple):
(define witness (snd result))

; Assignment for x1:
(fst witness)

; Assignment for x2:
(fst (snd witness))

; Assignment for x3:
(snd (snd witness))

; Independently verify that the candidate witness satisfies f:
(verify3 f witness)

; Independently verify that an invalid assignment (false, false, false) is rejected:
(verify3 f (pair false (pair false false)))
