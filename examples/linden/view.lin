; Linden - the engine as a plugin of its own, loaded BY PATH and registered.
; load_lib dlopens it (RTLD_GLOBAL); set_driver then finds its lin_linden_driver and registers it.
(load "std/std.lin")
(load_lib "./linden/linden.so")
(set_driver "linden")
; a real window (entry: ... t0 dt frames scale)
(define v_args (cons 320.0 (cons 240.0 (cons 8.0 (cons 12.0 (cons -1.0 (cons -1.0 (cons -1.0 (cons 1.0 (cons -1.0 (cons -1.0 (cons -1.0 (cons 1.0 (cons -1.0 (cons 1.0 (cons 1.0 (cons -1.0 (cons -1.0 (cons -1.0 (cons 1.0 (cons 1.0 (cons -1.0 (cons 1.0 (cons -1.0 (cons 1.0 (cons 1.0 (cons 1.0 (cons 1.0 (cons 1.0 (cons 0.0 (cons 1.0 (cons 0.0 (cons 2.0 (cons 1.0 (cons 3.0 (cons 2.0 (cons 3.0 (cons 4.0 (cons 5.0 (cons 4.0 (cons 6.0 (cons 5.0 (cons 7.0 (cons 6.0 (cons 7.0 (cons 0.0 (cons 4.0 (cons 1.0 (cons 5.0 (cons 2.0 (cons 6.0 (cons 3.0 (cons 7.0 (cons 0.0 (cons 0.06 (cons 120.0 (cons 3.0 nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))

(ccall "lin_fp_linden_window" v_args)
