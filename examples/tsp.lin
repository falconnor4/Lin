; ==============================================================================
; Traveling Salesperson Problem (TSP) in Lin
;
; Demonstrates:
;   1. Combinatorial encoding of candidate tours as boolean decision variables.
;   2. Evaluating the TSP decision predicate: exists tau. cost(tau) <= B.
;   3. Self-reducible witness probing: extracting candidate tour assignments.
;   4. Independent certificate verification: verifying that the candidate
;      witness satisfies all tour and budget constraints.
; ==============================================================================

(load "std/sat.lin")
(load "std/list.lin")
(load "std/pair.lin")

; ------------------------------------------------------------------------------
; Problem Instance: 4 Cities Metric Graph
;
; Cities:
;   0: Hub / Central Station
;   1: North District (Alpha)
;   2: East District  (Beta)
;   3: South District (Gamma)
;
; Symmetric Distance Matrix D[u][v]:
;        0    1    2    3
;   0 [  0,   4,   8,  12 ]
;   1 [  4,   0,   6,   7 ]
;   2 [  8,   6,   0,   5 ]
;   3 [ 12,   7,   5,   0 ]
;
; Fixing the starting city to 0 to eliminate cyclic rotational symmetries,
; there are (4 - 1)! / 2 = 3 unique undirected tours:
;
;   Tour A: 0 -> 1 -> 2 -> 3 -> 0
;           Cost: D(0,1) + D(1,2) + D(2,3) + D(3,0) = 4 + 6 + 5 + 12 = 27
;
;   Tour B: 0 -> 1 -> 3 -> 2 -> 0  [OPTIMAL]
;           Cost: D(0,1) + D(1,3) + D(3,2) + D(2,0) = 4 + 7 + 5 + 8  = 24
;
;   Tour C: 0 -> 2 -> 1 -> 3 -> 0
;           Cost: D(0,2) + D(2,1) + D(1,3) + D(3,0) = 8 + 6 + 7 + 12 = 33
; ------------------------------------------------------------------------------

; Candidate Tour Encoding via 2 Boolean Decision Variables (b0, b1):
;   b0 = false, b1 = false  =>  Tour A (cost 27)
;   b0 = false, b1 = true   =>  Tour B (cost 24, optimal)
;   b0 = true,  b1 = false  =>  Tour C (cost 33)

; Decode witness into a concrete inductive Lin list of cities
(define decode_tour
  (\w
    (ifl (fst w)
      ; b0 = true => Tour C
      (\_ (cons 0 (cons 2 (cons 1 (cons 3 (cons 0 nil))))))
      ; b0 = false => check b1
      (\_ (ifl (snd w)
            ; b1 = true => Tour B (Optimal: 0 -> 1 -> 3 -> 2 -> 0)
            (\_ (cons 0 (cons 1 (cons 3 (cons 2 (cons 0 nil))))))
            ; b1 = false => Tour A (0 -> 1 -> 2 -> 3 -> 0)
            (\_ (cons 0 (cons 1 (cons 2 (cons 3 (cons 0 nil)))))))))))

; Cost function of the decoded tour
(define tour_cost
  (\w
    (ifl (fst w)
      (\_ 33)
      (\_ (ifl (snd w)
            (\_ 24)
            (\_ 27))))))

; ------------------------------------------------------------------------------
; TSP Decision Problem Predicates
; ------------------------------------------------------------------------------

; Decision Problem 1: Budget B = 25
; Can the salesperson visit all 4 cities with cost <= 25?
; Tour A (27) > 25  => No
; Tour B (24) <= 25 => YES (b0 = false, b1 = true)
; Tour C (33) > 25  => No
(define tsp_b25
  (\b0 (\b1
    (and (not b0) b1))))

; Decision Problem 2: Budget B = 20
; Can the salesperson visit all 4 cities with cost <= 20?
; All tours have cost >= 24 > 20 => UNSATISFIABLE
(define tsp_b20
  (\b0 (\b1
    false)))

; Decision Problem 3: Budget B = 30
; Can the salesperson visit all 4 cities with cost <= 30?
; Tours A (27) and B (24) are both <= 30 => SATISFIABLE
(define tsp_b30
  (\b0 (\b1
    (or (and (not b0) (not b1))
        (and (not b0) b1)))))

; ------------------------------------------------------------------------------
; Demonstration
; ------------------------------------------------------------------------------

; --- Instance 1: Budget B = 25 (SAT) ---
; Lin extracts the satisfying model witness in non-abelian interaction nets
(define model25 (probe2 tsp_b25))

; Check satisfiability
(fst model25)

; Extracted witness bits: (b0, b1)
(define witness25 (snd model25))

; Independent Certificate Verification: check tsp_b25(witness) directly
(verify2 tsp_b25 witness25)

; Compute and report the optimal tour cost
(tour_cost witness25)

; Reconstruct and project the full tour sequence
(define opt_tour (decode_tour witness25))
(first opt_tour)
(second opt_tour)
(third opt_tour)
(fourth opt_tour)
(fifth opt_tour)

; --- Instance 2: Budget B = 20 (UNSAT) ---
(define model20 (probe2 tsp_b20))
(fst model20)

; --- Instance 3: Budget B = 30 (SAT) ---
(define model30 (probe2 tsp_b30))
(fst model30)
