; ==============================================================================
; C Foreign Function Interface (FFI) in Lin
;
; Demonstrates direct interoperability with the C runtime:
;   1. Invoking libc puts to print text to stdout
;   2. Reading system environment variables via getenv
;   3. Outputting raw ASCII character codes via putchar
; ==============================================================================

(load "std/ffi.lin")

; Print message directly to stdout via libc puts:
(puts "Hello from the Lin Interaction Net Runtime!")

; Inspect system environment variables:
(getenv "USER")
(getenv "SHELL")

; Output ASCII characters: 'A' (65) and newline (10)
(putchar 65)
(putchar 10)
