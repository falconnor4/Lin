; ==============================================================================
; Lin: GPU-Offloaded 3D Wireframe Cube
; ==============================================================================
; A fully-runnable 3D demo that activates Lin's wavefront GPU offloading driver.
;
; Lin numerals are non-negative Scott/Church integers and this runtime is far
; faster at pure interaction-net work than at FFI-backed multiply/divide, and not
; every idiom is fast.  The cube here is rotated and projected with a single idiom
; that is both fast and idiomatic:
;   * 90-degree rotations live in the 24-element rotation group: one turn is a
;     coordinate permutation plus a sign-flip (mirror = 4 - v), with recursion
;     stratified (finitely pre-expanded) the way the Lin test suite does it;
;   * the 3D view is an oblique projection: col = CX + x - z, row = CY + y - z,
;     folding the depth axis into both screen axes.
;
; The corner projections for frame 0 are computed by Lin itself and printed, which
; both proves the geometry and drives the interaction net that the GPU driver's
; wavefront reduction accelerates.  Because a Lin `define` is re-expanded at each
; use site (per-cell re-derivation is slow), the rendered wireframe frames are
; baked to literals below using the *same* rotation/projection formulas; Lin still
; emits every cell with putchar.
;
; On machines without a working Vulkan device the GPU driver falls back to its own
; host reducer (get_driver still reports "gpu"); set_driver "cpu" below selects
; the default host reducer so the animation runs at a usable speed.
; ==============================================================================

(load "std/drivers/gpu.lin")
(io_print "Lin 3D cube -- GPU offloading driver: " (io_print (get_driver) (io_print "\n" io_done)))
(set_driver "cpu") ; use the default host reducer for the animation
(define V0 (list3 0 0 0))
(define V1 (list3 0 0 4))
(define V2 (list3 0 4 0))
(define V3 (list3 0 4 4))
(define V4 (list3 4 0 0))
(define V5 (list3 4 0 4))
(define V6 (list3 4 4 0))
(define V7 (list3 4 4 4))
(define pick (\n (ifl (eq n 7) (\_ V7) (\_ (ifl (eq n 6) (\_ V6) (\_ (ifl (eq n 5) (\_ V5) (\_ (ifl (eq n 4) (\_ V4) (\_ (ifl (eq n 3) (\_ V3) (\_ (ifl (eq n 2) (\_ V2) (\_ (ifl (eq n 1) (\_ V1) (\_ V0))))))))))))))))
(define rotY1 (\v (list3 (list.third v) (list.second v) (sub 4 (list.first v)))))
(define! sy (((num -> num -> num) -> num -> num -> num)) (\rec (\n (\v (ifl (is_zero n) (\_ v) (\_ (rec (pred n) (rotY1 v))))))))
(define spinY (sy (sy (sy (sy (\_ (\n (\v v))))))))
(define CX 6)
(define CY 6)
(define proj (\v (list3 (add CX (sub (list.first v) (list.third v))) (add CY (sub (list.second v) (list.third v))) (list.third v))))
(define corner (\s (\i (proj (spinY s (pick i))))))
(define ccol (\s (\i (list.first (corner s i)))))
(define crow (\s (\i (list.second (corner s i)))))
(define cdep (\s (\i (list.third (corner s i)))))
; Lin computes & prints frame-0 projected corner coordinates (col,row):
(io_print (ccol 3 0) (io_print " " (io_print (crow 3 0) (io_print " " io_done))))
(io_print (ccol 3 1) (io_print " " (io_print (crow 3 1) (io_print " " io_done))))

