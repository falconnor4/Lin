; Dynamic per-pixel GPU-offloaded 3D wireframe cube (Lin)
; Each pixel is computed live in Lin: per-cell edge tests on the oblique
; projection, with the 8 projected vertices hoisted into a `let` so they are
; computed once per frame (not once per pixel).  Only +1 diagonal, horizontal
; and vertical edges occur, so rasterizing needs add/sub/eq/leq/abs_diff on
; small ints (<=10) -- no mul/div.

(load "std/std.lin")
(load "std/drivers/gpu.lin")
(io_print "Lin 3D cube -- GPU offloading driver: " (io_print (get_driver) (io_print "\n" io_done)))
(set_driver "cpu")

(define V0 (list3 0 0 0))
(define V1 (list3 0 0 4))
(define V2 (list3 0 4 0))
(define V3 (list3 0 4 4))
(define V4 (list3 4 0 0))
(define V5 (list3 4 0 4))
(define V6 (list3 4 4 0))
(define V7 (list3 4 4 4))

(define pick (\n (ifl (eq n 0) (\_ V0) (\_ (ifl (eq n 1) (\_ V1) (\_ (ifl (eq n 2) (\_ V2) (\_ (ifl (eq n 3) (\_ V3) (\_ (ifl (eq n 4) (\_ V4) (\_ (ifl (eq n 5) (\_ V5) (\_ (ifl (eq n 6) (\_ V6) (\_ V7))))))))))))))))

(define rotY1 (\v (list3 (third v) (second v) (sub 4 (first v)))))
(define! sy (((num -> num -> num) -> num -> num -> num)) (\rec (\n (\v (ifl (is_zero n) (\_ v) (\_ (rec (pred n) (rotY1 v))))))))
(define spinY (sy (sy (sy (sy (\_ (\n (\v v))))))))

(define CX 6)
(define CY 6)
(define ax (\c (\z (ifl (geq c z) (\_ (add 6 (sub c z))) (\_ (sub 6 (sub z c)))))))
(define proj (\v (list3 (ax (first v) (third v)) (ax (second v) (third v)) (third v))))
(define corner (\s (\i (proj (spinY s (pick i))))))
(define cx (\s (\i (first (corner s i)))))
(define cy (\s (\i (second (corner s i)))))
(define cz (\s (\i (third (corner s i)))))

(define hon (\x0 (\y0 (\x1 (\px (\py (and (eq py y0) (and (leq (min x0 x1) px) (leq px (max x0 x1))))))))))
(define von (\x0 (\y0 (\y1 (\px (\py (and (eq px x0) (and (leq (min y0 y1) py) (leq py (max y0 y1))))))))))
(define don (\x0 (\y0 (\x1 (\y1 (\px (\py (and (eq (abs_diff px x0) (abs_diff py y0)) (and (leq (min x0 x1) px) (and (leq px (max x0 x1)) (and (leq (min y0 y1) py) (leq py (max y0 y1)))))))))))))
(define ddep (\x0 (\z0 (\x1 (\px (ifl (is_zero z0) (\_ (abs_diff px x0)) (\_ (abs_diff px x1))))))))
(define rank (\d (ifl (leq 3 d) (\_ 2) (\_ (ifl (eq 2 d) (\_ 1) (\_ 0))))))
(define rchar (\r (ifl (eq 2 r) (\_ 35) (\_ (ifl (eq 1 r) (\_ 43) (\_ 46))))))

; ---- frame 0 (per-pixel, corners hoisted) ----
