; ==============================================================================
; Elementary Cellular Automata (Rule 90 & Rule 110) in Lin
;
; Demonstrates:
;   1. Simulating discrete dynamical systems on interaction nets.
;   2. Rule 90: Additive linear automaton generating Sierpinski triangle fractals.
;   3. Rule 110: Proven Turing-complete universal cellular automaton.
;   4. Synchronous spatial updates without arrays or mutable memory buffers.
; ==============================================================================

(load "std/bool.lin")
(load "std/pair.lin")

; ------------------------------------------------------------------------------
; 1. Local Neighborhood Transition Rules
; Given left (L), center (C), and right (R) neighbors:
; ------------------------------------------------------------------------------

; Rule 90: L XOR R (Sierpinski fractal generator)
(define rule90
  (\l (\c (\r (xor l r)))))

; Rule 110: Universal computation rule
;   If L is 1: C XOR R
;   If L is 0: C OR R
(define rule110
  (\l (\c (\r (if l (xor c r) (or c r))))))

; ------------------------------------------------------------------------------
; 2. 8-Cell Circular Universe Evolution Step
; Propagates transitions synchronously across a ring:
;   x0, x1, x2, x3, x4, x5, x6, x7
; with periodic boundary conditions (x0 left neighbor is x7, x7 right neighbor is x0).
; ------------------------------------------------------------------------------
(define step_rule90
  (\x0 (\x1 (\x2 (\x3 (\x4 (\x5 (\x6 (\x7
    (pair (rule90 x7 x0 x1)
    (pair (rule90 x0 x1 x2)
    (pair (rule90 x1 x2 x3)
    (pair (rule90 x2 x3 x4)
    (pair (rule90 x3 x4 x5)
    (pair (rule90 x4 x5 x6)
    (pair (rule90 x5 x6 x7)
          (rule90 x6 x7 x0)))))))))))))))))

(define step_rule110
  (\x0 (\x1 (\x2 (\x3 (\x4 (\x5 (\x6 (\x7
    (pair (rule110 x7 x0 x1)
    (pair (rule110 x0 x1 x2)
    (pair (rule110 x1 x2 x3)
    (pair (rule110 x2 x3 x4)
    (pair (rule110 x3 x4 x5)
    (pair (rule110 x4 x5 x6)
    (pair (rule110 x5 x6 x7)
          (rule110 x6 x7 x0)))))))))))))))))

; ------------------------------------------------------------------------------
; 3. Simulation: Rule 90 Single Impulse Evolution
; Generation 0: 0 0 0 0 1 0 0 0  (center cell x4 = true)
; ------------------------------------------------------------------------------
(define gen0_x4 true)
(define gen0_rest false)

(define gen1 (step_rule90 gen0_rest gen0_rest gen0_rest gen0_rest
                          gen0_x4   gen0_rest gen0_rest gen0_rest))

; Under Rule 90, the single impulse splits into x3 and x5:
; Cell x0:
(fst gen1)

; Cell x3:
(fst (snd (snd (snd gen1))))

; Cell x4 (center died):
(fst (snd (snd (snd (snd gen1)))))

; Cell x5:
(fst (snd (snd (snd (snd (snd gen1))))))

; ------------------------------------------------------------------------------
; 4. Simulation: Rule 110 Active Pattern Step
; ------------------------------------------------------------------------------
(define u110 (step_rule110 false false false true true false false false))

; Resulting states of cells x2, x3, x4:
(fst (snd (snd u110)))
(fst (snd (snd (snd u110))))
(fst (snd (snd (snd (snd u110)))))
