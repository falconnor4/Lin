; regex-redux (Computer Language Benchmarks Game): a DNA sequence of 200,000 letters, drawn by the benchmark's
; generator from its IUB alphabet, is searched for nine variant patterns, then rewritten by five substitutions,
; with std/regex.lin.  The answer combines the nine counts and the rewritten length.
(define next (\seed (mod (add (mul seed 3877) 29573) 139968)))
; the IUB alphabet, by cumulative weight out of 139968: a c g t B D H K M N R S V W Y
(define iub (\r (if (lt r 37791) 97 (if (lt r 54587) 99 (if (lt r 71383) 103 (if (lt r 109174) 116 (if (lt r 111973) 66 (if (lt r 114772) 68 (if (lt r 117571) 72 (if (lt r 120370) 75 (if (lt r 123170) 77 (if (lt r 125969) 78 (if (lt r 128768) 82 (if (lt r 131567) 83 (if (lt r 134366) 86 (if (lt r 137165) 87 89))))))))))))))))
(define draw (\k (\seed (if (eq k 0) nil (let ((s (next seed))) (cons (iub s) (draw (sub k 1) s)))))))
(define variants (cons "agggtaaa|tttaccct" (cons "[cgt]gggtaaa|tttaccc[acg]" (cons "a[act]ggtaaa|tttacc[agt]t" (cons "ag[act]gtaaa|tttac[agt]ct" (cons "agg[act]taaa|ttta[agt]cct" (cons "aggg[acg]aaa|ttt[cgt]ccct" (cons "agggt[cgt]aa|tt[acg]accct" (cons "agggta[cgt]a|t[acg]taccct" (cons "agggtaa[cgt]|[acg]ttaccct" nil))))))))))
(define counts (\s (\ps (\i (\acc (if (is_empty ps) acc (counts s (tail ps) (add i 1) (add acc (mul i (re_count (regex (head ps)) s))))))))))
; the substitutions, applied in turn
(define subst (\s (re_replace (regex "\\|[^|][^|]*\\|") "-" (re_replace (regex "<[^>]*>") "|" (re_replace (regex "a[NSt]|BY") "<2>" (re_replace (regex "aND|caN|Ha[DS]|WaS") "<3>" (re_replace (regex "tHa[Nt]") "<4>" s)))))))
(define run (\s (add (counts s variants 1 0) (mul 1000000 (str_length (subst s))))))
(run (draw 200000 42))
